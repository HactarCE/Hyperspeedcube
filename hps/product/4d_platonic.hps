//-----------------//
// Simplex puzzles //
//-----------------//

common_4simplex = #{
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 4,
    colors = "4simplex",
    twists = "4simplex_fvt",
}

fn build_4simplex(vt_cut_depths: List[Num]) {
    @util.build_symmetric_shape(@shapes/4d/4simplex.new())
    vertex_layers = [∞] ++ vt_cut_depths ++ [-∞]
    facet_layers = @util/layers.opposite(vertex_layers)
    #puz.layers.A = facet_layers
    #puz.layers.βA = vertex_layers
}

add_puzzle_list_entry("4simplex_a(1)")
add_puzzle(id = "4simplex_a@1", name = "N-Layer 4-Simplex A",
    params = [cuts_param], gen = fn(cuts) { #{
        name = n_layer_prefix(cuts + 1, default = 2) ++ "4-Simplex A",
        build = fn() { build_4simplex(rev(@util/layers.inclusive_exclusive(2/3, 3/2, cuts))) },
    } },
    **common_4simplex,
)

add_puzzle_list_entry("4simplex_b(1)")
add_puzzle(id = "4simplex_b@1", name = "N-Layer 4-Simplex B",
    params = [cuts_param], gen = fn(cuts) { #{
        name = n_layer_prefix(cuts + 1, default = 2) ++ "4-Simplex B",
        build = fn() { build_4simplex(@util/layers.exclusive(2/3, 1/4, cuts, padding=1/2)) },
    } },
    **common_4simplex,
)

add_puzzle(id = "4simplex_c@1", name = ["4-Simplex C", "Adjacent-Cut 4-Simplex"],
    build = fn() { build_4simplex([1/4]) },
    **common_4simplex,
)

add_puzzle_list_entry("4simplex_d(1)")
add_puzzle(id = "4simplex_d@1", name = "N-Layer 4-Simplex D",
    params = [cuts_param], gen = fn(cuts) { #{
        name = n_layer_prefix(cuts + 1, default = 2) ++ "4-Simplex D",
        build = fn() { build_4simplex(@util.layers.inclusive_exclusive(0, -1, cuts)) },
    } },
    **common_4simplex,
)

add_puzzle_list_entry("4simplex_pyraminx(3)")
add_puzzle(id = "4simplex_pyraminx@1", name = "N-Layer 4-Simplex Pyraminx",
    params = [layers_param], gen = fn(layers) { #{
        name = n_layer_prefix(layers) ++ "4-Simplex Pyraminx",
        build = fn() { build_4simplex(@util.layers.exclusive(4, -1, layers-1)) },
    } },
    **common_4simplex,
)

//-------------------//
// Hypercube puzzles //
//-------------------//

add_puzzle_list_entry("hypercube_ft(2)")
add_puzzle_list_entry("hypercube_ft(3)")
add_puzzle_list_entry("hypercube_ft(4)")
add_puzzle_list_entry("hypercube_ft(5)")
add_puzzle_list_entry("hypercube_ft(6)")
add_puzzle_list_entry("hypercube_ft(7)")
add_puzzle(id = "hypercube_ft@1", name = ["N-Layer FT Hypercube", "n^4", "NxNxNxN FT Hypercube", "N-Layer 4D Rubik's Cube"],
    tags = #{ author = ["Andrew Farkas", "Milo Jacquet"] },
    engine = "symmetric",
    ndim = 4,
    colors = "hypercube",
    twists = "hypercube_ft",
    params = [layers_param],
    gen = fn(layers) {
        names = ["${layers}^4", "${layers}x${layers}x${layers}x${layers}"]
        if layers == 3 { names ++= ["4D Rubik's Cube", "Canon-Cut Hypercube"] }
        return #{
            name = names,
            build = fn() {
                @util.build_symmetric_shape(@shapes/4d/hypercube.new())
                #puz.layers.R = @util/layers/ft.cube(4, layers)
            },
        }
    }
)

