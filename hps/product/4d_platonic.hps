fn def_24cell_ft(cut_depths: List[Num], **kwargs) {
    add_puzzle(
        tags = #{ author = "Andrew Farkas" },
        engine = "symmetric",
        ndim = 4,
        colors = "24cell",
        twists = "24cell_ft",
        build = fn() {
            @util.build_symmetric_shape(@shapes/4d/24cell.new())
            #puz.layers.A = @util/layers.with_opposite([∞] ++ cut_depths)
        },
        **kwargs,
    )
}

def_24cell_ft([2/3],  id = "24cell_ft_1@1", name = ["FT 24-Cell 1", "Canon-Cut 24-Cell", "Shallow-Cut FT 24-Cell"])
def_24cell_ft([3/5],  id = "24cell_ft_2@1", name = ["FT 24-Cell 2"])
def_24cell_ft([1/2],  id = "24cell_ft_3@1", name = ["FT 24-Cell 3", "Adjacent-Cut FT 24-Cell"])
def_24cell_ft([2/5],  id = "24cell_ft_4@1", name = ["FT 24-Cell 4"])
def_24cell_ft([1/3],  id = "24cell_ft_5@1", name = ["FT 24-Cell 5"])
def_24cell_ft([7/25], id = "24cell_ft_6@1", name = ["FT 24-Cell 6"])
def_24cell_ft([1/4],  id = "24cell_ft_7@1", name = ["FT 24-Cell 7"])
def_24cell_ft([2/9],  id = "24cell_ft_8@1", name = ["FT 24-Cell 8"])
def_24cell_ft([1/5],  id = "24cell_ft_9@1", name = ["FT 24-Cell 9"])
def_24cell_ft([1/6],  id = "24cell_ft_10@1", name = ["FT 24-Cell 10", "Astral FT 24-Cell"])
def_24cell_ft([0],    id = "24cell_ft_11@1", name = ["FT 24-Cell 11", "Half-Cut FT 24-Cell"])
def_24cell_ft([2/3, 1/3], id = "24cell_ft_hybrid_1_5@1", name = ["FT 24-Cell 1 + 5"])

