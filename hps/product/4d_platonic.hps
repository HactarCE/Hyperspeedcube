//--------------//
// Basic shapes //
//--------------//

fn add_basic_shape(shape_file, **kwargs) {
    add_puzzle(
        engine = "symmetric",
        ndim = 4,
        colors = kwargs.id,
        build = fn() { @util.build_symmetric_shape(shape_file.new()) },
        **kwargs,
    )
}

add_basic_shape(@shapes/4d/4simplex,  id = "4simplex@1",  name = ["4-Simplex", "5-Cell", "Pentachoron"])
add_basic_shape(@shapes/4d/hypercube, id = "hypercube@1", name = ["Hypercube", "8-Cell", "Octachoron", "4-Cube", "4D Cube", "Tesseract", "1x1x1x1", "1^4"])
add_basic_shape(@shapes/4d/16cell,    id = "16cell@1",    name = ["16-Cell", "Hexadecachoron", "Hyperoctahedron", "4-Orthoplex"])
add_basic_shape(@shapes/4d/24cell,    id = "24cell@1",    name = ["24-Cell", "Icositetrachoron", "Octaplex"])
add_basic_shape(@shapes/4d/120cell,   id = "120cell@1",   name = ["120-Cell", "Hecatonicosachoron", "Dodecaplex", "Hyperdodecahedron"])
add_basic_shape(@shapes/4d/600cell,   id = "600cell@1",   name = ["600-Cell", "Hexacosichoron", "Tetraplex", "Hypericosahedron"])

