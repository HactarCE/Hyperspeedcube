)

fn def_chamfered_tetrahedron_ft(cube_depth, **kwargs) {
    add_puzzle(
        engine = "symmetric",
        twists = "chamfered_tetrahedron_ft",
        ndim = 3,
        build = fn() {
            cube = @shapes/3d/cube.new()
            tetrahedron = cube.tetrahedra()[0]
            r = 2/√3
            #shape.sym = tetrahedron.sym
            #shape.points = cube.points
            #shape.facets = [cube.facet, r * tetrahedron.facet.unit]
            d = 0.75
            #puz.layers.U = [1, cube_depth, -cube_depth, -1]
            #puz.layers.UFR = [∞, (1 - (1-cube_depth)/√2) * 2/√3]
        },
        **kwargs,
    )
}

def_chamfered_tetrahedron_ft(
    0.75,
    id = "chamfered_tetrahedron_canon",
    name = ["Canon-Cut FT Chamfered Tetrahedron", "Canon-Cut FT Chamfered Tetrahedron"],
    tags = #{ author = ["Andrew Farkas", "SuperSnowman16"] },
)

def_chamfered_tetrahedron_ft(
    0.6,
