// Polygon x Polygon
add_color_system_hook(
    "sum([ngon(*),ngon(*)])",
    0,
    fn(n, m) {
        default_scheme = #{}
        for i in 0..parse_int(n) {
            default_scheme["a${nth_uppercase(i)}"] = "Dark Rainbow [${i}/${n}]"
        }
        for i in 0..parse_int(m) {
            default_scheme["b${nth_uppercase(i)}"] = "Light Rainbow [${i}/${m}]"
        }
        return #{ schemes = #{ Main = default_scheme } }
    },
)

// Polygon x Line
add_color_system_hook(
    "sum([ngon(*),line])",
    0,
    fn(n) {
        default_scheme = #{}
        for i in 0..parse_int(n) {
            default_scheme["a${nth_uppercase(i)}"] = "Rainbow [${i}/${n}]"
        }
        default_scheme["bA"] = "White"
        default_scheme["bB"] = "Gray"
        return #{ schemes = #{ Main = default_scheme } }
    },
)

// Line x Polygon
add_color_system_hook(
    "sum([line,ngon(*)])",
    0,
    fn(n) {
        default_scheme = #{}
        default_scheme["aA"] = "White"
        default_scheme["aB"] = "Gray"
        for i in 0..parse_int(n) {
            default_scheme["b${nth_uppercase(i)}"] = "Rainbow [${i}/${n}]"
        }
        return #{ schemes = #{ Main = default_scheme } }
    },
)

// Dodecahedron x Line
add_color_system_hook(
    "sum([dodecahedron,line])",
    0,
    fn() {
        default_scheme = #{
            aU = "White",
            aF = "Green Dyad [1]",
            aR = "Red",
            aL = "Purple",
            aBR = "Blue Dyad [1]",
            aBL = "Yellow Dyad [1]",
            aDR = "Yellow Dyad [0]",
            aDL = "Blue Dyad [0]",
            aPR = "Pink",
            aPL = "Orange",
            aPB = "Green Dyad [0]",
            aPD = "Gray",
            bA = "Black",
            bB = "Brown",
        }
        return #{ schemes = #{ Main = default_scheme } }
    },
)

// Line x Dodecahedron
add_color_system_hook(
    "sum([line,dodecahedron])",
    0,
    fn() {
        default_scheme = #{
            aA = "Black",
            aB = "Brown",
            bU = "White",
            bF = "Green Dyad [1]",
            bR = "Red",
            bL = "Purple",
            bBR = "Blue Dyad [1]",
            bBL = "Yellow Dyad [1]",
            bDR = "Yellow Dyad [0]",
            bDL = "Blue Dyad [0]",
            bPR = "Pink",
            bPL = "Orange",
            bPB = "Green Dyad [0]",
            bPD = "Gray",
        }
        return #{ schemes = #{ Main = default_scheme } }
    },
)

