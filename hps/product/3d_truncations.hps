//-------------------------- //
// Icosidodecahedron puzzles //
//-------------------------- //

fn def_icosidodecahedron(t, **kwargs) {
    def_truncation(@shapes/3d/dodecahedron, "oxo", twists = "dodecahedron_ft_vt", cuts = #{ f = [t], v = [t] }, **kwargs)
}

def_icosidodecahedron(1-(1-1/φ)*1/4,  id = "icosidodecahedron_ft_1@0",  name = ["FT Icosidodecahedron 1", "Shallow-Cut Icosidodecahedron", "Canon-Cut Icosidodecahedron"])
def_icosidodecahedron(1-(1-1/φ)*1/3,  id = "icosidodecahedron_ft_2@0",  name = "FT Icosidodecahedron 2")
def_icosidodecahedron(1-(1-1/φ)*2/5,  id = "icosidodecahedron_ft_3@0",  name = "FT Icosidodecahedron 3")
def_icosidodecahedron(1-(1-1/φ)*1/2,  id = "icosidodecahedron_ft_4@0",  name = "FT Icosidodecahedron 4")
def_icosidodecahedron(1-(1-1/φ)*3/5,  id = "icosidodecahedron_ft_5@0",  name = "FT Icosidodecahedron 5")
def_icosidodecahedron(1-(1-1/φ)*2/3,  id = "icosidodecahedron_ft_6@0",  name = "FT Icosidodecahedron 6")
def_icosidodecahedron(1-(1-1/φ)*0.69, id = "icosidodecahedron_ft_7@0",  name = "FT Icosidodecahedron 7")
def_icosidodecahedron(√((φ + 1)/5),  id = "icosidodecahedron_ft_8@0",  name = "FT Icosidodecahedron 8")
