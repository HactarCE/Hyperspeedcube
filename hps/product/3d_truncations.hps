//---------------//
// Twist systems //
//---------------//

fn def_truncation_twists(shape_file, vertex_cd_point, **kwargs) {
    add_twist_system(
        engine = "symmetric",
        ndim = 3,
        build = fn() {
            shape = shape_file.new()
            #twists.sym = shape.sym
            #twists.points = shape.points
            elements = #{ f = shape.face, e = shape.edge, v = shape.vertex }
            p = shape.sym.vec(vertex_cd_point)
            p /= p.projected_to(shape.sym.oox).mag
            for k in ["f", "e", "v"] {
                if dot(p.unit, elements[k].unit) != 1 {
                    #twists.axes ++= [p.projected_to(elements[k])]
                }
            }
        },
        **kwargs,
    )
}

def_truncation_twists(@shapes/3d/cube, "oxo", id = "cube_ft_vt@1", name = "FT+VT Cube")
def_truncation_twists(@shapes/3d/cube, "xox", id = "cube_ft_et_vt@0", name = "FT+ET+VT Cube") // TODO: jumbling angles (ET cube)
def_truncation_twists(@shapes/3d/dodecahedron, "oxo", id = "dodecahedron_ft_vt@1", name = "FT+VT Dodecahedron") // TODO: jumbling angles (FT icosahedron)

//------- //
// Shapes //
//------- //

fn def_truncation(shape_file, vertex_cd_point, *, cuts = null, layers = #{}, **kwargs) {
    add_puzzle(
        engine = "symmetric",
        ndim = 3,
        build = fn() {
            shape = shape_file.new()
            #shape.sym = shape.sym
            #shape.points = shape.points
            elements = #{ f = shape.face, e = shape.edge, v = shape.vertex }
            axes = #{ f = "R", e = "RU", v = "RUF" }
            p = shape.sym.vec(vertex_cd_point)
            p /= p.projected_to(shape.sym.oox).mag
            for k in ["f", "e", "v"] {
                if dot(p.unit, elements[k].unit) != 1 {
                    facet_pole = p.projected_to(elements[k])
                    #shape.facets ++= [facet_pole]
                    if cuts != null {
                        #puz.layers[axes[k]] = @util/layers.with_opposite([∞] ++ cuts[k].map(fn(d) { d * facet_pole.mag }))
                    }
                }
            }
        },
        tags = #{ author = ["Andrew Farkas", "SuperSnowman16", "Milo Jacquet"] },
        **kwargs,
    )
}

def_truncation(@shapes/3d/cube, "oxo", id = "cuboctahedron@1", name = "Cuboctahedron")
def_truncation(@shapes/3d/cube, "xxo", id = "truncated_cube@1", name = "Truncated Cube")
def_truncation(@shapes/3d/cube, "oxx", id = "truncated_octahedron@1", name = "Truncated Octahedron")
def_truncation(@shapes/3d/cube, "xox", id = "rhombicuboctahedron@1", name = "Rhombicuboctahedron")
def_truncation(@shapes/3d/cube, "xxx", id = "truncated_cuboctahedron@1", name = "Truncated Cuboctahedron")
def_truncation(@shapes/3d/dodecahedron, "oxo", id = "icosidodecahedron@1", name = "Icosidodecahedron")

//---------------------- //
// Cuboctahedron puzzles //
//---------------------- //

fn def_cuboctahedron(t, **kwargs) {
    def_truncation(@shapes/3d/cube, "oxo", twists = "cube_ft_vt", cuts = #{ f = [t], v = [t] }, **kwargs)
}

