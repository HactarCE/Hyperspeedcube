//---------------//
// Twist systems //
//---------------//

fn def_truncation_twists(shape_file, vertex_cd_point, **kwargs) {
    add_twist_system(
        engine = "symmetric",
        ndim = 3,
        build = fn() {
            shape = shape_file.new()
            #twists.sym = shape.sym
            #twists.points = shape.points
            elements = #{ f = shape.face, e = shape.edge, v = shape.vertex }
            p = shape.sym.vec(vertex_cd_point)
            p /= p.projected_to(shape.sym.oox).mag
            for k in ["f", "e", "v"] {
                if dot(p.unit, elements[k].unit) != 1 {
                    #twists.axes ++= [p.projected_to(elements[k])]
                }
            }
        },
        **kwargs,
    )
}

def_truncation_twists(@shapes/3d/cube, "oxo", id = "cube_ft_vt")
def_truncation_twists(@shapes/3d/cube, "xox", id = "cube_ft_et_vt")

//------- //
// Shapes //
//------- //

fn def_truncation(shape_file, vertex_cd_point, *, cuts = null, layers = #{}, **kwargs) {
    add_puzzle(
        engine = "symmetric",
        ndim = 3,
        build = fn() {
            shape = shape_file.new()
            #shape.sym = shape.sym
            #shape.points = shape.points
            elements = #{ f = shape.face, e = shape.edge, v = shape.vertex }
            axes = #{ f = "R", e = "RU", v = "RUF" }
            p = shape.sym.vec(vertex_cd_point)
            p /= p.projected_to(shape.sym.oox).mag
            for k in ["f", "e", "v"] {
                if dot(p.unit, elements[k].unit) != 1 {
                    facet_pole = p.projected_to(elements[k])
                    #shape.facets ++= [facet_pole]
                    if cuts != null {
                        #puz.layers[axes[k]] = @util/layers.with_opposite([∞] ++ cuts[k].map(fn(d) { d * facet_pole.mag }))
                    }
                }
            }
        },
        tags = #{ author = ["Andrew Farkas", "SuperSnowman16", "Milo Jacquet"] },
        **kwargs,
    )
}

def_truncation(@shapes/3d/cube, "oxo", id = "cuboctahedron", name = "Cuboctahedron")
def_truncation(@shapes/3d/cube, "xxo", id = "truncated_cube", name = "Truncated Cube")
def_truncation(@shapes/3d/cube, "oxx", id = "truncated_octahedron", name = "Truncated Octahedron")
def_truncation(@shapes/3d/cube, "xox", id = "rhombicuboctahedron", name = "Rhombicuboctahedron")
def_truncation(@shapes/3d/cube, "xxx", id = "truncated_cuboctahedron", name = "Truncated Cuboctahedron")

//---------------------- //
// Cuboctahedron puzzles //
//---------------------- //

fn def_cuboctahedron(t, **kwargs) {
    def_truncation(@shapes/3d/cube, "oxo", twists = "cube_ft_vt", cuts = #{ f = [t], v = [t] }, **kwargs)
}

// Numbering courtesy of Luna Harran
def_cuboctahedron(3/4,  id = "cuboctahedron_ft_1",  name = ["FT Cuboctahedron 1", "Canon-Cut Cuboctahedron"])
def_cuboctahedron(2/3,  id = "cuboctahedron_ft_2",  name = "FT Cuboctahedron 2")
def_cuboctahedron(3/5,  id = "cuboctahedron_ft_3",  name = "FT Cuboctahedron 3")
def_cuboctahedron(1/2,  id = "cuboctahedron_ft_4",  name = ["FT Cuboctahedron 4", "Rainbow Cube + 3^3"])
def_cuboctahedron(2/5,  id = "cuboctahedron_ft_5",  name = "FT Cuboctahedron 5")
def_cuboctahedron(1/3,  id = "cuboctahedron_ft_6",  name = "FT Cuboctahedron 6")
def_cuboctahedron(7/24, id = "cuboctahedron_ft_7",  name = "FT Cuboctahedron 7")
