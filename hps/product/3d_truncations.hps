//---------------------------- //
// Rhombicuboctahedron puzzles //
//---------------------------- //

fn def_rhombicuboctahedron(t, **kwargs) {
    cuts = #{
        f = [t],
        e = [lerp(1-1/√2, 1, t)],
        v = [lerp(2/(3+√2), 1, t)],
    }
    def_truncation(@shapes/3d/cube, "xox", twists = "cube_ft_et_vt", cuts = cuts, **kwargs)
}

