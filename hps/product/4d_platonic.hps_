add_twist_system(
    id = "hypercube_ft",
    name = "FT Hypercube",
    engine = "symmetric",
    ndim = 4,
    subsets = [
        #{id = "rot", name = "Rot", default = true},
        #{id = "refle", name = "Refle", maximal = true},
    ],
    build = fn(subset) {
        shape = @shapes/4d/hypercube.new()
        #twists.sym = if subset == "rot" { shape.sym.chiral } else { shape.sym }
        #twists.points = [shape.facet]
        #twists.axes = [shape.facet]
        if subset == "rot" {
            #twists.stabilizer_twists = [
                [["R", "U"], 1],
                [["R", "U"], (1 + GIZMO_EDGE_FACTOR) / √2],
                [["R", "U", "F"], (1 + 2 * GIZMO_EDGE_FACTOR) / √3],
            ]
        }
    }
)

add_puzzle(
    id = "hypercube_ft",
    name = "FT Hypercube",
    version = "0.1.0",
    engine = "symmetric",
    ndim = 4,
    colors = "hypercube",
    params = [#{ name = "Layers", type = Int, default = 3, min = 1, max = 50 }],
    subsets = [
        #{id = "rot", name = "Rot", default = true},
        #{id = "refle", name = "Refle", maximal = true},
    ],
    gen = fn(layers, subset) {
        export name = "${layers}^4"
        export twists = "hypercube_ft.${subset}",
        export fn build() {
            shape = @shapes/4d/hypercube.new()
            #shape.sym = shape.sym
            #shape.colors = shape.colors
            #shape.facets ++= [shape.facet]
            #puz.layers.R = @util.layers.inclusive(layers)
        }
    },
)
