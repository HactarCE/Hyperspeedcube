//-------------------- //
// Rhombic dodecahedra //
//-------------------- //

add_twist_system(
    id = "rhombic_dodecahedron_ft@0",
    name = "FT Rhombic Dodecahedron",
    engine = "symmetric",
    ndim = 3,
    build = fn() {
        cube = @shapes/3d/cube.new()
        #twists.sym = cube.sym
        #twists.points = cube.points
        #twists.axes = [cube.edge.unit]
        #twists.stabilizer_twists = [
            [["UF", "F"], 1/2],
            [["UF", "L"], 1/(2*√2)],
        ]
        #twists.stabilizer_sets = [
            [["R", "U"], 1],
            [["R", "U", "F"], (2*√2-1)/√3],
        ]
        #twists.jumble_moves.UF = #{ j = "UR->RF" }
        #twists.jumble_stops.UF = ["j"]
    }
)

add_puzzle(
    id = "rhombic_dodecahedron@1",
    name = "Rhombic Dodecahedron",
    engine = "symmetric",
    ndim = 3,
    build = fn() {
        cube = @shapes/3d/cube.new()
        #shape.sym = cube.sym
        #shape.points = cube.points
        #shape.facets = [cube.edge.unit]
    },
)

fn def_rhombic_dodecahedron(cut_depths, **kwargs) {
    add_puzzle(
        tags = #{ author = "Andrew Farkas" },
        engine = "symmetric",
        ndim = 3,
        twists = "rhombic_dodecahedron_ft",
        build = fn() {
            cube = @shapes/3d/cube.new()
            #shape.sym = cube.sym
            #shape.points = cube.points
            #shape.facets = [cube.edge.unit]
            #puz.layers.RF = @util/layers.with_opposite([1] ++ cut_depths)
        },
        **kwargs,
    )
}
def_rhombic_dodecahedron([2/3], id = "rhombic_dodecahedron_ft_1@0", name = ["FT Rhombic Dodecahedron 1", "Tahi", "Canon-Cut FT Rhombic Dodecahedron"])
def_rhombic_dodecahedron([1/2], id = "rhombic_dodecahedron_ft_2@0", name = ["FT Rhombic Dodecahedron 2", "Rua"])
def_rhombic_dodecahedron([2/5], id = "rhombic_dodecahedron_ft_3@0", name = ["FT Rhombic Dodecahedron 3"])
def_rhombic_dodecahedron([1/3], id = "rhombic_dodecahedron_ft_4@0", name = ["FT Rhombic Dodecahedron 4", "Toru"])
def_rhombic_dodecahedron([1/4], id = "rhombic_dodecahedron_ft_5@0", name = ["FT Rhombic Dodecahedron 5"])
def_rhombic_dodecahedron([0],   id = "rhombic_dodecahedron_ft_6@0", name = ["FT Rhombic Dodecahedron 6", "Rhombic Dodecahedron Chop", "Half-Cut FT Rhombic Dodecahedron"])

