// Rhombic Triacontahedron //
//------------------------ //

add_twist_system(
    id = "rhombic_triacontahedron_ft@0",
    name = "FT Rhombic Triacontahedron",
    engine = "symmetric",
    ndim = 3,
    build = fn() {
        dodecahedron = @shapes/3d/dodecahedron.new()
        #twists.sym = dodecahedron.sym
        #twists.points = dodecahedron.points
        #twists.axes = [dodecahedron.edge]
        #twists.stabilizer_twists = [
            [["UF", "F"], 1/φ/2],
            [["UF", "L"], 1/φ^2/2],
        ]
        #twists.stabilizer_sets = [
            [["R", "U"], lerp(dodecahedron.edge.mag, φ / √(φ + 2), 0.5)],
            [["R", "U", "F"], lerp(dodecahedron.vertex.mag, (φ + 1) / √(3*φ + 6), 0.5)],
        ]
        #twists.jumble_moves.UF = #{ h = "PRR->DLDR", ja = "UR->RF", jb = "DRF->DLF" }
        #twists.jumble_stops.UF = ["h", "ja", "jb"]
        // TODO: only add `h` at high enough cut depths (`jumbl2` subset)
    }
)

add_puzzle(
    id = "rhombic_triacontahedron@1",
    name = "Rhombic Triacontahedron",
    engine = "symmetric",
    ndim = 3,
    build = fn() {
        dodecahedron = @shapes/3d/dodecahedron.new()
        #shape.sym = dodecahedron.sym
        #shape.points = dodecahedron.points
        #shape.facets = [dodecahedron.edge.unit]
    },
)

fn def_rhombic_triacontahedron(cut_depths, **kwargs) {
    add_puzzle(
        tags = #{ author = "Andrew Farkas" },
        engine = "symmetric",
        ndim = 3,
        twists = "rhombic_triacontahedron_ft",
        build = fn() {
            dodecahedron = @shapes/3d/dodecahedron.new()
            #shape.sym = dodecahedron.sym
            #shape.points = dodecahedron.points
            #shape.facets = [dodecahedron.edge]
            #puz.layers.RF = @util/layers.with_opposite([∞] ++ cut_depths.map(fn (x) { x * dodecahedron.edge.mag }))
        },
        **kwargs,
    )
}

def_rhombic_triacontahedron([0.85], id = "rhombic_triacontahedron_ft_canon@0", name = "Canon-Cut FT Rhombic Triacontahedron")
def_rhombic_triacontahedron([φ/2], id = "rhombic_triacontahedron_ft_adj@0", name = "Adjacent-Cut FT Rhombic Triacontahedron")
// d = (2*φ+4) / ((8*φ+6) - (4*φ+3)/√(3*φ+2) - √(4*φ^2 + 11*φ + 6)) // sweet spot, no mechanism due to zero-area corner stalk
// d = 3/4 // looks good, but piece overhangs
// sweet spot near 0.723, but piece overhangs
def_rhombic_triacontahedron([0.675], id = "golden_ratio_labyrinth@0", name = "Golden Ratio Labyrinth")
def_rhombic_triacontahedron([1/φ], id = "big_kahuna@0", name = "Big Kahuna")
def_rhombic_triacontahedron([1/φ/2], id = "ftrtc_jumble_test@0", name = "FT Rhombic Triacontahedron Jumbling Test")
def_rhombic_triacontahedron([0], id = "rhombic_triacontahedron_ft_half@0", name = "Half-Cut FT Rhombic Triacontahedron")
