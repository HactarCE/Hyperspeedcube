//---------------//
// Twist systems //
//---------------//

fn def_truncation_twists(
    shape_file,
    vertex_cd_point,
    axes: Map,
    *,
    **kwargs,
) {
    add_twist_system(
        engine = "symmetric",
        ndim = 4,
        build = fn() {
            shape = shape_file.new()
            #twists.sym = shape.sym
            #twists.points = shape.points
            elements = #{ f = shape.facet, e = shape.edge, r = shape.ridge, v = shape.vertex }
            p = shape.sym.vec(vertex_cd_point)
            p /= p.projected_to(shape.sym.ooox).mag
            for i, k in ["f", "e", "r", "v"] {
                facet_pole = p.projected_to(elements[k])
                if @util.cd_element_exists(vertex_cd_point, [i]) {
                    #twists.axes ++= [facet_pole]

                    // TODO: this algorithm for adding gizmos is insufficient
                    for i2, k2 in ["f", "e", "r", "v"] {
                        if i != i2 and @util.cd_element_exists(vertex_cd_point, [i, i2]) {
                            pole_distance = (facet_pole - p.projected_to([elements[k], elements[k2]])).mag
                            print(i, k, i2, k2, axes[k])
                            secondary = axes[k2].filter(fn(x) { x != strcat(axes[k]) })
                            #twists.stabilizer_twists ++= [[[strcat(axes[k]), *secondary], pole_distance]]
                        }
                    }
                    // HOW TO GET GIZMO POLE DISTANCE:
                    // 1. remove node corresponding to axis
                    // 2. remove node corresponding to stabilizer set
                    // 3. remove connected components with no ringed nodes (i.e., no `x`s)
                    // 4. project point onto all removed nodes (from steps 1-3)
                    // 5. if any nodes removed in step 3, reduce the pole distance by some amount so that it is visible on gizmo
                }
            }
        },
        **kwargs,
    )
}

axes_120cell = #{ f = ["IR"], r = ["IR", "IU"], e = ["IR", "IU", "IF"], v = ["IR", "IU", "IF", "II"] }
fn strcat(strings: List[Str]) -> Str {
    strings.reduce(fn(a, b) { a ++ b })
}

def_truncation_twists(
    @shapes/4d/120cell, "oxxo", axes_120cell,
    id = "120cell_ft_vt@1", name = "FT+VT 120-Cell",
