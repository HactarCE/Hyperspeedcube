//------- //
// Shapes //
//------- //

fn def_truncation(shape_file, vertex_cd_point, axes: Map, *, cuts = null, layers = #{}, **kwargs) {
    add_puzzle(
        engine = "symmetric",
        ndim = 4,
        build = fn() {
            shape = shape_file.new()
            #shape.sym = shape.sym
            #shape.points = shape.points
            elements = #{ f = shape.facet, r = shape.ridge, e = shape.edge, v = shape.vertex }
            p = shape.sym.vec(vertex_cd_point)
            p /= p.projected_to(shape.sym.ooox).mag
            for i, k in ["f", "r", "e", "v"] {
                if @util.cd_element_exists(vertex_cd_point, [i]) {
                    facet_pole = p.projected_to(elements[k])
                    #shape.facets ++= [facet_pole]
                    if cuts != null {
                        axis_name = strcat(axes[k])
                        #puz.cuts[axis_name] = @util/cuts.with_opposite(cuts[k].map(fn(d) { d * facet_pole.mag }))
                        #puz.is_full_cut[axis_name] = true
                    }
                }
            }
        },
        tags = #{ author = ["Andrew Farkas", "SuperSnowman16", "Milo Jacquet"] },
        **kwargs,
    )
}

def_truncation(@shapes/4d/120cell, "oxxo", axes_120cell, id = "120cell_bitruncated@1", name = "Bitruncated 120-Cell")

