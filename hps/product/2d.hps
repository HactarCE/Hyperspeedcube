add_puzzle(id = "ngon_ft_half@1", name = "Half-Cut FT Polygon Generator",
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 2,
    params = [edges_param],
    gen = fn(n) {
        return #{
            name = "Half-Cut {${n}}",
            colors = "ngon(${n})",
            twists = "ngon_ft(${n})",
            build = fn() {
                @util.build_symmetric_shape(@shapes/2d/polygon.new(n))
                #puz.cuts.A = [0]
                #puz.is_full_cut.A = true
            },
        }
    },
)

add_puzzle(id = "ngon_ft_layered@1", name = "Layered FT Polygon Generator",
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 2,
    params = [edges_param, layers_param],
    gen = fn(n, layers) {
        name = ["Layered {${n}}${layers}"]
        if n == 3 { name ++= ["Triminx ${layers}"] }
        return #{
            name = name,
            colors = "ngon(${n})",
            twists = "ngon_ft(${n})",
            build = fn() {
                shape = @shapes/2d/polygon.new(n)
                @util.build_symmetric_shape(shape)
                #puz.cuts.A = shape.layered_ft_cuts(layers-1)
                #puz.is_full_cut.A = true
            },
        }
    },
)

add_puzzle(id = "ngon_ft_astral@1", name = "Astral FT Polygon Generator",
    tags = #{ author = ["Andrew Farkas", "SuperSnowman16"] },
    engine = "symmetric",
    ndim = 2,
    params = [edges_param],
    gen = fn(n) {
        return #{
            name = "Astral {${n}}",
            colors = "ngon(${n})",
            twists = "ngon_ft(${n})",
            build = fn() {
                shape = @shapes/2d/polygon.new(n)
                @util.build_symmetric_shape(shape)
                min_angle = π/n * (floor(n/2)+1) // angle between nearest non-parallel planes
                recip_max_intersection_radius = cos(min_angle) // reciprocal of outermost intersection, assuming cut depth = 1
                cut_depth_lower_bound = cos(min_angle) * if floor(n/2).is_odd() { shape.inradius } else { shape.circumradius }
                #puz.cuts.A = [cut_depth_lower_bound/2]
                #puz.is_full_cut.A = n == 3
            },
        }
    },
)

