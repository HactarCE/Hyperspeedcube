add_puzzle(id = "ngon_ft_astral", name = "Astral FT Polygon Generator",
    tags = #{ author = ["Andrew Farkas", "SuperSnowman16"] },
    engine = "symmetric",
    ndim = 2,
    params = [edges_param],
    gen = fn(n) {
        return #{
            name = "Astral {${n}}",
            colors = "ngon(${n})",
            twists = "ngon_ft(${n})",
            build = fn() {
                shape = @shapes/2d/polygon.new(n)
                @util.build_symmetric_shape(shape)
                min_angle = π/n * (floor(n/2)+1) // angle between nearest non-parallel planes
                recip_max_intersection_radius = cos(min_angle) // reciprocal of outermost intersection, assuming cut depth = 1
                cut_depth_lower_bound = cos(min_angle) * if floor(n/2).is_odd() { shape.inradius } else { shape.circumradius }
                #puz.layers.A = [∞, cut_depth_lower_bound/2]
            },
        }
    },
)

