GIZMO_VERTEX_FACTOR = 2/3

use edges_param from @shapes/2d/polygon
edge_divisions_param = #{ name = "Edge divisions", type = Int, default = 3, min = 1, max = 50 }
layers_param = #{ name = "Layers", type = Int, default = 3, min = 1, max = 50 }

add_menu_entry(path = "Solid|2D", next_column = "Shape")

add_menu_entry(path = "Solid|2D|Triangle", priority = -3,  next_inline = "Depth")
add_menu_entry(path = "Solid|2D|Square",   priority = -4,  id = "square_ft_layered")
add_menu_entry(path = "Solid|2D|Polygon",  priority = -5,  next_inline = "Axes",  default = true)

add_menu_entry(path = "Solid|2D|Triangle|Shallow", id = "triangle_ft_shallow")
add_menu_entry(path = "Solid|2D|Triangle|Triminx", id = "triangle_layered")

add_menu_entry(path = "Solid|2D|Polygon|None", priority = 100, id = "ngon")

add_menu_entry(path = "Solid|2D|Polygon|FT",   priority = 1,   next_inline = "Depth",   default = true)
add_menu_entry(path = "Solid|2D|Polygon|FT|Shallow", priority = 100, id = "ngon_ft_shallow", default = true)
// add_menu_entry(path = "Solid|2D|Polygon|FT|Deep",    priority = 4,   id = "ngon_ft_deep") // TODO: decide what to do with this
add_menu_entry(path = "Solid|2D|Polygon|FT|Half",    priority = 3,   id = "ngon_ft_half")
add_menu_entry(path = "Solid|2D|Polygon|FT|Layered", priority = 2,   id = "ngon_ft_layered")
add_menu_entry(path = "Solid|2D|Polygon|FT|Astral",  priority = 1,   id = "ngon_ft_astral")

add_menu_entry(path = "Solid|2D|Polygon|VT",   priority = 0,   next_inline = "Depth")
add_menu_entry(path = "Solid|2D|Polygon|VT|Adjacent", priority = 3,   id = "ngon_vt_adj")
add_menu_entry(path = "Solid|2D|Polygon|VT|Half",     priority = 2,   id = "ngon_vt_half")
add_menu_entry(path = "Solid|2D|Polygon|VT|Layered",  priority = 1,   id = "ngon_vt_layered")

add_menu_entry(path = "Solid|2D|Polygon|FT+VT", priority = -1,  id = "ngon_ft_vt")

add_twist_system(id = "ngon_ft@1", name = "FT Polygon Generator",
    engine = "symmetric",
    ndim = 2,
    params = [edges_param],
    gen = fn(n) {
        return #{
            name = "FT {${n}}",
            build = fn() {
                shape = @shapes/2d/polygon.new(n)
                #twists.sym = shape.sym
                #twists.points = shape.points
                #twists.axes = [shape.facet]
                #twists.stabilizer_twists = [[["A", "B"], shape.edge_length/2]]
                #twists.stabilizer_sets = [[["A", "B"], lerp(shape.circumradius, shape.inradius, GIZMO_VERTEX_FACTOR)]]
            },
        }
    },
)

add_twist_system(id = "ngon_vt@1", name = "VT Polygon Generator",
    engine = "symmetric",
    ndim = 2,
    params = [edges_param],
    gen = fn(n) {
        return #{
            name = "VT {${n}}",
            build = fn() {
                shape = @shapes/2d/polygon.new(n)
                #twists.sym = shape.sym
                #twists.points = shape.points
                #twists.axes = [shape.vertex.unit * shape.facet.mag]
                #twists.stabilizer_twists = [[["AB", "A"], shape.edge_length/2]]
                #twists.stabilizer_sets = [[["A", "B"], lerp(shape.circumradius, shape.inradius, GIZMO_VERTEX_FACTOR)]]
            },
        }
    },
)

add_twist_system(id = "ngon_ft_vt@1", name = "FT+VT Polygon Generator",
    engine = "symmetric",
    ndim = 2,
    params = [edges_param],
    gen = fn(n) {
        return #{
            name = "FT+VT {${n}}",
            build = fn() {
                shape = @shapes/2d/polygon.new(n)
                doubled_polygon = @shapes/2d/polygon.new(2*n)
                stabilizer_twist_radius = doubled_polygon.edge_length/2 * shape.inradius/doubled_polygon.inradius
                #twists.sym = shape.sym
                #twists.points = shape.points
                #twists.axes = [
                    shape.facet,
                    shape.vertex.unit * shape.facet.mag,
                ]
                #twists.stabilizer_twists = [
                    [["A", "B"], stabilizer_twist_radius],
                    [["AB", "A"], stabilizer_twist_radius],
                ]
                #twists.stabilizer_sets = [[["A", "B"], shape.inradius]]
            },
        }
    },
)

add_puzzle(id = "triangle_ft_shallow@1", name = "Shallow-Cut FT Triangle Generator",
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 2,
    params = [edge_divisions_param],
    gen = fn(divisions) { "ngon_ft_shallow(3,${divisions})" },
)

add_puzzle(id = "square_ft_layered@1", name = "FT Square Generator",
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 2,
    params = [layers_param],
    gen = fn(layers) { "ngon_ft_layered(4,${layers})" },
)

add_puzzle(id = "square_vt_layered@1", name = "VT Square Generator",
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 2,
    params = [layers_param],
    gen = fn(layers) { "ngon_vt_layered(4,${layers})" },
)

add_puzzle(id = "triangle_layered@1", name = ["Layered FT Triangle Generator", "Triminx Generator"],
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 2,
    params = [layers_param],
    gen = fn(layers) { "ngon_ft_layered(3,${layers})" },
)

add_puzzle(id = "ngon@1", name = "Polygon Generator",
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 2,
    params = [edges_param],
    gen = fn(n) {
        return #{
            name = "{${n}}",
            colors = "ngon(${n})",
            build = fn() {
                @util.build_symmetric_shape(@shapes/2d/polygon.new(n))
            },
        }
    },
)

add_puzzle(id = "ngon_ft_shallow@1", name = "Shallow-Cut FT Polygon Generator",
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 2,
    params = [edges_param, edge_divisions_param],
    gen = fn(n, divisions) {
        return #{
            name = "{${n}}${divisions}",
            colors = "ngon(${n})",
            twists = "ngon_ft(${n})",
            build = fn() {
                shape = @shapes/2d/polygon.new(n)
                @util.build_symmetric_shape(shape)
                #puz.cuts.A = shape.shallow_ft_cuts(divisions)
                #puz.is_full_cut.A = n == 3
            },
        }
    },
)

