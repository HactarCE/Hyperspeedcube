GIZMO_VERTEX_FACTOR = 2/3

add_menu_entry(path = "Solid|2D|Triangle",            next_inline = "Depth",    priority = -3)
add_menu_entry(path = "Solid|2D|Triangle|Shallow",    id = "triangle_ft_shallow")
add_menu_entry(path = "Solid|2D|Triangle|Triminx",    id = "triangle_layered")
add_menu_entry(path = "Solid|2D|Square",              id = "square_ft_layered", priority = -4)
add_menu_entry(path = "Solid|2D|Polygon",             next_inline = "Axes",     priority = -5,  default = true)
add_menu_entry(path = "Solid|2D|Polygon|None",        id = "ngon",              priority = 100)
add_menu_entry(path = "Solid|2D|Polygon|FT",          next_inline = "Depth",    priority = 1,   default = true)
add_menu_entry(path = "Solid|2D|Polygon|FT|Shallow",  id = "ngon_ft_shallow",   priority = 100, default = true)
add_menu_entry(path = "Solid|2D|Polygon|FT|Deep",     id = "ngon_ft_deep",      priority = 3)
add_menu_entry(path = "Solid|2D|Polygon|FT|Half",     id = "ngon_ft_half",      priority = 2)
add_menu_entry(path = "Solid|2D|Polygon|FT|Layered",  id = "ngon_ft_layered",   priority = 1)
add_menu_entry(path = "Solid|2D|Polygon|VT",          next_inline = "Depth",    priority = 0)
add_menu_entry(path = "Solid|2D|Polygon|VT|Adjacent", id = "ngon_vt_adj",       priority = 1)
add_menu_entry(path = "Solid|2D|Polygon|VT|Half",     id = "ngon_vt_half",      priority = 0)
add_menu_entry(path = "Solid|2D|Polygon|FT+VT",       id = "ngon_ft_vt",        priority = -1)

use edges_param from @shapes/2d/polygon
edge_divisions_param = #{ name = "Edge divisions", type = Int, default = 3, min = 1, max = 50 }
layers_param = #{ name = "Layers", type = Int, default = 3, min = 1, max = 50 }

add_twist_system(id = "ngon_ft",
    engine = "symmetric",
    ndim = 2,
    params = [edges_param],
    gen = fn(n) {
        return #{
            build = fn() {
                shape = @shapes/2d/polygon.new(n)
                #twists.sym = shape.sym
                #twists.points = shape.named_points
                #twists.axes ++= [shape.facet]
                #twists.stabilizer_twists ++= [[["A", "B"], shape.edge_length/2]]
                #twists.stabilizer_sets ++= [[["A", "B"], lerp(shape.circumradius, @shapes/2d/polygon.new(n).inradius, GIZMO_VERTEX_FACTOR)]]
            },
        }
    },
)

add_twist_system(id = "ngon_vt",
    engine = "symmetric",
    ndim = 2,
    params = [edges_param],
    gen = fn(n) {
        return #{
            build = fn() {
                shape = @shapes/2d/polygon.new(n)
                #twists.sym = shape.sym
                #twists.points = shape.named_points
                #twists.axes ++= [shape.vertex]
                #twists.stabilizer_twists ++= [[["AB", "A"], shape.edge_length/2]]
                #twists.stabilizer_sets ++= [[["A", "B"], lerp(shape.circumradius, @shapes/2d/polygon.new(n).inradius, GIZMO_VERTEX_FACTOR)]]
            },
        }
    },
)

add_twist_system(id = "ngon_ft_vt",
    engine = "symmetric",
    ndim = 2,
    params = [edges_param],
    gen = fn(n) {
        return #{
            build = fn() {
                shape = @shapes/2d/polygon.new(n)
                #twists.sym = shape.sym
                #twists.points = shape.named_points
                #twists.axes ++= [shape.facet, shape.vertex]
                #twists.stabilizer_twists ++= [[["A", "B"], shape.edge_length/2], [["AB", "A"], shape.edge_length/2]]
                #twists.stabilizer_sets ++= [[["A", "B"], lerp(shape.circumradius, @shapes/2d/polygon.new(n).inradius, GIZMO_VERTEX_FACTOR)]]
            },
        }
    },
)

add_puzzle(id = "triangle_ft_shallow", name = "FT Triangle (Shallow)",
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 2,
    params = [edge_divisions_param],
    gen = fn(divisions) { "ngon_ft_shallow(3,${divisions})" },
)

add_puzzle(id = "square_ft_layered", name = "FT Square",
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 2,
    params = [layers_param],
    gen = fn(layers) { "ngon_ft_layered(4,${layers})" },
)

add_puzzle(id = "triangle_layered", name = "FT Triangle (Layered)",
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 2,
    params = [layers_param],
    gen = fn(layers) { "ngon_ft_layered(3,${layers})" },
)

add_puzzle(id = "ngon", name = "Polygon",
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 2,
    params = [edges_param],
    gen = fn(n) {
        return #{
            name = "${n}",
            colors = "ngon(${n})",
            twists = "ngon_ft(${n})", // todo: doesn't need axes
            build = fn() {
                @util.build_symmetric_shape(@shapes/2d/polygon.new(n))
            },
        }
    },
)

add_puzzle(id = "ngon_ft_shallow", name = "FT Polygon (Shallow-Cut)",
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 2,
    params = [edges_param, edge_divisions_param],
    gen = fn(n, divisions) {
        return #{
            name = "{${n}}${divisions}",
            colors = "ngon(${n})",
            twists = "ngon_ft(${n})",
            build = fn() {
                @util.build_symmetric_shape(@shapes/2d/polygon.new(n))
                #puz.layers.A = @shapes/2d/polygon.new(n).shallow_cut_depths(divisions)
            },
        }
    },
)

