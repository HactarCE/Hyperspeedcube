            build = fn() {
                shape = @shapes/2d/polygon.new(n)
                @util.build_symmetric_shape(@shapes/2d/polygon.new(n))
                #puz.layers.A = @shapes/2d/polygon.new(n).shallow_cut_depths(3)
                shallow_cut_depth = #puz.layers.A[1]
                #puz.layers.AB = [∞, shallow_cut_depth * shape.circumradius/shape.inradius]
