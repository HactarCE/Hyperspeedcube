use * from euclid

GIZMO_EDGE_FACTOR = 0.25

layers_param = #{ name = "Layers", type = Int, default = 3, min = 1, max = 50 }
cuts_param = #{ name = "Cuts", type = Int, default = 1, min = 1, max = 20 }

fn n_layer_prefix(n, *, default=3) { if n == default { "" } else { "${n}-Layer " } }
fn n_cut_prefix(n, *, default=1) { if n == default { "" } else { "${n}-Cut " } }

