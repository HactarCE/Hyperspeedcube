add_puzzle_list_entry("cube_ft(2)")
add_puzzle_list_entry("cube_ft(3)")
add_puzzle_list_entry("cube_ft(4)")
add_puzzle_list_entry("cube_ft(5)")
add_puzzle_list_entry("cube_ft(6)")
add_puzzle_list_entry("cube_ft(7)")
add_puzzle(id = "cube_ft", name = ["N-Layer FT Cube", "NxNxN FT Cube", "n^3", "N-Layer Rubik's Cube"],
    tags = #{ author = ["Andrew Farkas", "Milo Jacquet"] },
    engine = "symmetric",
    ndim = 3,
    colors = "cube",
    twists = "cube_ft",
    params = [layers_param],
    gen = fn(layers) {
        names = ["${layers}^3", "${layers}x${layers}x${layers}"]
        if layers == 2 { names ++= ["Pocket Cube"] }
        if layers == 3 { names ++= ["Rubik's Cube", "Canon-Cut Cube"] }
        if layers == 4 { names ++= ["Rubik's Revenge"] }
        if layers == 5 { names ++= ["Professor Cube"] }
        return #{
            name = names,
            build = fn() {
                @util.build_symmetric_shape(@shapes/3d/cube.new())
                #puz.layers.R = @util/layers/ft.cube(3, layers)
            },
        }
    }
)

