//--------------//
// Basic shapes //
//--------------//

fn add_basic_shape(shape_file, **kwargs) {
    add_puzzle(
        engine = "symmetric",
        ndim = 3,
        colors = kwargs.id,
        build = fn() { @util.build_symmetric_shape(shape_file.new()) },
        **kwargs,
    )
}

add_basic_shape(@shapes/3d/tetrahedron,  id = "tetrahedron",  name = ["Tetrahedron", "3-Simplex"])
add_basic_shape(@shapes/3d/cube,         id = "cube",         name = ["Cube", "3-Cube", "Hexahedron", "1x1x1", "1^3"])
add_basic_shape(@shapes/3d/octahedron,   id = "octahedron",   name = ["Octahedron", "3-Orthoplex"])
add_basic_shape(@shapes/3d/dodecahedron, id = "dodecahedron", name = "Dodecahedron")
add_basic_shape(@shapes/3d/icosahedron,  id = "icosahedron",  name = "Icosahedron")

//---------------//
// Twist systems //
//---------------//

add_twist_system(id = "tetrahedron_fvt", name = "FT/VT Tetrahedron",
    engine = "symmetric",
    ndim = 3,
    build = fn() {
        shape = @shapes/3d/tetrahedron.new()
        #twists.sym = shape.sym
        #twists.points = shape.points
        #twists.axes = [shape.facet, shape.vertex.unit * shape.facet.mag]
        #twists.stabilizer_twists = [
            [["R", "F"], 1/√2],
            [["R", "F", "L"], 1/√2],
            [["RFL", "F"], 1/√2],
            [["RFL", "F", "L"], 1/√2],
        ]
        #twists.stabilizer_sets = [
            [["R", "F"], lerp(√3, 1/√3, GIZMO_EDGE_FACTOR)],
            [["R", "F", "L"], 1],
        ]
    },
)

add_twist_system(id = "cube_ft", name = "FT Cube",
    engine = "symmetric",
    ndim = 3,
    build = fn() {
        shape = @shapes/3d/cube.new()
        #twists.sym = shape.sym
        #twists.points = shape.points
        #twists.axes = [shape.facet]
        #twists.stabilizer_twists = [
            [["R", "U"], 1],
            [["R", "U", "F"], lerp(√2, 1/√2, GIZMO_EDGE_FACTOR)],
        ]
        #twists.stabilizer_sets = [
            [["R", "U"], shape.edge.mag * lerp(1, 1/2, GIZMO_EDGE_FACTOR)],
            [["R", "U", "F"], shape.vertex.mag * lerp(1, 1/3, GIZMO_EDGE_FACTOR)],
        ]
    },
)

add_twist_system(id = "octahedron_ft", name = "FT Octahedron",
    engine = "symmetric",
    ndim = 3,
    build = fn() {
        shape = @shapes/3d/octahedron.new()
        #twists.sym = shape.sym
        #twists.points = shape.points
        #twists.axes = [shape.facet]
        ri = 1/√2 // facet inradius
        rc = √2 // facet circumradius
        #twists.stabilizer_twists = [
            [["R", "U"], ri],
            [["R", "L"], ri * lerp(rc/ri, ri/rc, GIZMO_EDGE_FACTOR)],
        ]
        #twists.stabilizer_sets = [
            [["R", "U"], lerp(shape.edge.mag, √2/√3, GIZMO_EDGE_FACTOR)],
            [["R", "U", "L", "F"], lerp(shape.vertex.mag, 1/√3, GIZMO_EDGE_FACTOR)],
        ]
    },
)

add_twist_system(id = "dodecahedron_ft", name = "FT Dodecahedron",
    engine = "symmetric",
    ndim = 3,
    build = fn() {
        shape = @shapes/3d/dodecahedron.new()
        #twists.sym = shape.sym
        #twists.points = shape.points
        #twists.axes = [shape.facet]
        ri = √((4*φ + 3) / (11*φ + 7)) // facet inradius
        rc = √((4*φ + 8) / (11*φ + 7)) // facet circumradius
        #twists.stabilizer_twists = [
            [["R", "U"], ri],
            [["R", "U", "F"], ri * lerp(rc/ri, ri/rc, GIZMO_EDGE_FACTOR)],
        ]
        #twists.stabilizer_sets = [
            [["R", "U"], lerp(shape.edge.mag, φ / √(φ + 2), GIZMO_EDGE_FACTOR)],
            [["R", "U", "F"], lerp(shape.vertex.mag, (φ + 1) / √(3*φ + 6), GIZMO_EDGE_FACTOR)],
        ]
    },
)

add_twist_system(id = "icosahedron_ft", name = "FT Icosahedron",
    engine = "symmetric",
    ndim = 3,
    build = fn() {
        shape = @shapes/3d/icosahedron.new()
        #twists.sym = shape.sym
        #twists.points = shape.points
        #twists.axes = [shape.facet]
        ri = 1/(φ+1) // facet inradius
        rc = 2/(φ+1) // facet circumradius
        #twists.stabilizer_twists = [
            [["F", "R"], ri],
            [["F", "R", "U"], ri * lerp(rc/ri, ri/rc, GIZMO_EDGE_FACTOR)],
        ]

        dodeca = @shapes/3d/dodecahedron.new()
        #twists.stabilizer_sets = [
            [["F", "R"], lerp(shape.edge.mag, dodeca.edge.mag/dodeca.vertex.mag, GIZMO_EDGE_FACTOR)],
            [["U", "F", "R", "E", "G"], lerp(shape.vertex.mag, dodeca.facet.mag/dodeca.vertex.mag, GIZMO_EDGE_FACTOR)],
            // [["R", "F", "U", "G", "E"], dodeca.facet.mag/dodeca.vertex.mag], // TODO: why wrong direction?
            // TODO: move input doesn't work for these twists? e.g., `bB_aU_aF_aR_aE_aG`
        ]
    },
)

//---------------------//
// Tetrahedron puzzles //
//---------------------//

add_puzzle_list_entry("tetrahedron_a(1)")
add_puzzle(id = "tetrahedron_a", name = "N-Layer Tetrahedron A",
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 3,
    colors = "tetrahedron",
    twists = "tetrahedron_fvt",
    params = [cuts_param],
    gen = fn(cuts) {
        return #{
            name = n_layer_prefix(cuts + 1, default = 2) ++ "Tetrahedron A",
            build = fn() {
                @util.build_symmetric_shape(@shapes/3d/tetrahedron.new())
                vertex_layers = [∞] ++ @util/layers.exclusive(1, 1/3, cuts, padding=1/2) ++ [-∞]
                facet_layers = @util/layers.opposite(vertex_layers)
                #puz.layers.R = facet_layers
                #puz.layers.RFL = vertex_layers
            },
        }
    }
)

add_puzzle(id = "tetrahedron_b", name = ["Tetrahedron B", "Tetraminx"],
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 3,
    colors = "tetrahedron",
    twists = "tetrahedron_fvt",
    build = fn() {
        @util.build_symmetric_shape(@shapes/3d/tetrahedron.new())
        vertex_layers = [∞, 1/3, -∞]
        facet_layers = @util/layers.opposite(vertex_layers)
        #puz.layers.R = facet_layers
        #puz.layers.RFL = vertex_layers
    },
)

add_puzzle_list_entry("tetrahedron_c(1)")
add_puzzle_list_entry("tetrahedron_c(4)")
add_puzzle(id = "tetrahedron_c", name = ["N-Layer Tetrahedron C", "N-Layer FT+VT Tetrahedron (Shallow)"],
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 3,
    colors = "tetrahedron",
    twists = "tetrahedron_fvt",
    params = [cuts_param],
    gen = fn(cuts) {
        names = [n_layer_prefix(cuts + 1, default = 2) ++ "Tetrahedron C"]
        if cuts == 1 {
            names ++= [
                "Jing's Pyraminx", // https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1578
                "Halpern-Meier Tetrahedron", // https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=547
                "Obieemnaia Logicheskaia Igra", // https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=9618
                "Canon-Cut Tetrahedron",
            ]
        }
        if cuts == 3 { names ++= ["Elite Tetrahedron"] } // https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2016
        if cuts == 4 { names ++= ["Royal Tetrahedron"] } // https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=2006
        return #{
            name = names,
            build = fn() {
                @util.build_symmetric_shape(@shapes/3d/tetrahedron.new())
                facet_layers = @util/layers/ft.simplex_shallow(3, cuts)
                vertex_layers = @util/layers.opposite(facet_layers)
                #puz.layers.R = facet_layers
                #puz.layers.RFL = vertex_layers
            },
        }
    }
)

add_puzzle_list_entry("pyraminx(3)")
add_puzzle(id = "pyraminx", name = "N-Layer Pyraminx",
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 3,
    colors = "tetrahedron",
    twists = "tetrahedron_fvt",
    params = [layers_param],
    gen = fn(layers) {
        names = [n_layer_prefix(layers) ++ "Pyraminx"]
        if layers == 4 { names = ["Master Pyraminx"] ++ names }
        if layers == 6 { names = ["Royal Pyraminx"] ++ names } // https://twistypuzzles.com/app/museum/museum_showitem.php?pkey=1819
        return #{
            name = names,
            build = fn() {
                @util.build_symmetric_shape(@shapes/3d/tetrahedron.new())
                facet_layers = @util/layers.inclusive(1, -3, layers)
                vertex_layers = @util/layers.opposite(facet_layers)
                #puz.layers.R = facet_layers
                #puz.layers.RFL = vertex_layers
            },
        }
    }
)

