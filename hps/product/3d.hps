// ------------ //
// Cube puzzles //
//------------- //

add_puzzle_list_entry("cube_ft(3)")
add_puzzle_list_entry("cube_ft(4)")
add_puzzle_list_entry("cube_ft(5)")
add_puzzle_list_entry("cube_ft(6)")
add_puzzle_list_entry("cube_ft(7)")
add_puzzle(id = "cube_ft", name = "FT Cube",
    aliases = ["n^3", "N-Layer Rubik's Cube"],
    tags = #{ author = ["Andrew Farkas", "Milo Jacquet"] },
    engine = "symmetric",
    ndim = 3,
    colors = "cube",
    twists = "cube_ft",
    params = [layers_param],
    gen = fn(layers) {
        extra_aliases = ([
            [],                  // 0
            [],                  // 1
            ["Pocket Cube"],     // 2
            ["Rubik's Cube"],    // 3
            ["Rubik's Revenge"], // 4
            ["Professor Cube"],  // 5
        ][layers] ?? [])
        return #{
            name = "${layers}^3",
            aliases = ["${layers}x${layers}x${layers}"] ++ extra_aliases,
            build = fn() {
                @util.build_symmetric_shape(@shapes/3d/cube.new())
                #puz.layers.R = @util.ft_cube_cut_depths(3, layers)
            },
        }
    }
)

add_puzzle(id = "megaminx", name = "FT Dodecahedron",
    // aliases = ["FT Hexahedron", "n^3", "N-Layer Rubik's Cube"],
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 3,
    // colors = "dodecahedron",
    twists = "dodecahedron_ft",
    params = [layers_param],
    gen = fn(layers) {
        aliases = ["${layers}x${layers}x${layers}"]
        extra_alias = [null, null, "Pocket Cube", "Rubik's Cube", "Rubik's Revenge", "Professor Cube"][layers]
        if extra_alias != null {
            aliases ++= [extra_alias]
        }
        return #{
            name = "${layers}^3",
            // aliases = aliases,
            build = fn() {
                shape = @shapes/3d/dodecahedron.new()
                sym = shape.sym
                #shape.sym = shape.sym
                #shape.points = [sym.oox.unit]
                #shape.facets = [sym.oox.unit]
                // TODO: realistic proportions
                #puz.layers.ZZA = [1,1/φ+0.1]
            },
        }
    }
)

