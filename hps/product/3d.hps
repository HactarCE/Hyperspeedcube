add_puzzle(id = "tetrahedron", name = "Tetrahedron",
    aliases = ["3-Simplex"],
    engine = "symmetric",
    ndim = 3,
    colors = "tetrahedron",
    build = fn() { @util.build_symmetric_shape(@shapes/3d/tetrahedron.new()) },
)

add_puzzle(id = "cube", name = "Cube",
    aliases = ["3-Cube", "Hexahedron", "1x1x1", "1^3"],
    engine = "symmetric",
    ndim = 3,
    colors = "cube",
    build = fn() { @util.build_symmetric_shape(@shapes/3d/cube.new()) },
)

