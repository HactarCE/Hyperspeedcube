add_puzzle_list_entry("pentultimate(2)")
add_puzzle_list_entry("pentultimate(3)")
add_puzzle_list_entry("pentultimate(4)")
add_puzzle_list_entry("pentultimate(5)")
add_puzzle_list_entry("pentultimate(7)")
add_puzzle(id = "pentultimate", name = "N-Layer Pentultimate",
    tags = #{ author = ["Andrew Farkas", "Milo Jacquet"] },
    engine = "symmetric",
    ndim = 3,
    colors = "dodecahedron",
    twists = "dodecahedron_ft",
    params = [#{**layers_param, default = 2}],
    gen = fn(layers) {
        names = [n_layer_prefix(layers, default = 2) ++ "Pentultimate"]
        if layers == 3 { names = ["Master Pentultimate"] ++ names }
        if layers == 4 { names = ["Elite Pentultimate"] ++ names }
        if layers == 5 { names = ["Royal Pentultimate"] ++ names }
        if layers == 7 { names = ["God Emperor Pentultimate"] ++ names }
        return #{
            name = names,
            build = fn() {
                @util.build_symmetric_shape(@shapes/3d/dodecahedron.new())
                #puz.layers.F = @util/layers/ft.pentultimate(layers)
            },
        }
    }
)

///////

fn def_ft_icosahedron(id, name, cut_depths: List[Num], *, add_opposite = true) {
    add_puzzle(
        id = id,
        name = name,
        tags = #{ author = "Jason White" },
        engine = "symmetric",
        ndim = 3,
        colors = "icosahedron",
        twists = "icosahedron_ft",
        build = fn() {
            @util.build_symmetric_shape(@shapes/3d/icosahedron.new())
            if add_opposite {
                cut_depths ++= @util/layers.opposite(cut_depths)
            }
            #puz.layers.A = cut_depths
        },
    )
}

use RADIO_4, RADIO_5, RADIO_7, RADIO_8, RADIO_11, RADIO_12, RADIO_13 from @util/layers/ft

diff = 0.08
def_ft_icosahedron("eitans_nebula", "Eitan's Nebula", [1, RADIO_4+diff, RADIO_4])

galaxy = √((6/(47 + 21*√5)) + ((3*√3 - √15)/2)^2)
def_ft_icosahedron("eitans_galaxy", "Eitan's Galaxy", [1, galaxy, RADIO_7])

// def_ft_icosahedron("radio_1", ["Radiolarian 1"], [1, 0.8])
def_ft_icosahedron("radio_1_5", ["Radiolarian 1.5", "Radio Canon", "FT Icosahedron (Shallow)", "Canon-Cut Icosahedron"], [1, 7/9])
def_ft_icosahedron("radio_2", ["Radiolarian 2", "Circo-Radiolarian"], [1, 1 - (1-RADIO_4)*2/3])
def_ft_icosahedron("radio_3", ["Radiolarian 3"], [1, 1 - (1-RADIO_4)*4/5])
def_ft_icosahedron("radio_4", ["Radiolarian 4", "Eitan's Star", "DeFTI"], [1, RADIO_4])
def_ft_icosahedron("radio_4_5", ["Radiolarian 4.5"], [1, lerp(RADIO_4, RADIO_5, 3/5)])
def_ft_icosahedron("radio_5", ["Radiolarian 5", "Cat's Cradle"], [1, RADIO_5])
def_ft_icosahedron("radio_6", ["Radiolarian 6", "Radio Web"], [1, RADIO_7 + 0.02])
def_ft_icosahedron("radio_7", ["Radiolarian 7", "Radio Jewel"], [1, RADIO_7])
def_ft_icosahedron("radio_8", ["Radiolarian 8", "Radio Jam"], [1, RADIO_7 - 0.06])
def_ft_icosahedron("radio_8_5", ["Radiolarian 8.5"], [1, 1/3 + 0.03])
def_ft_icosahedron("radio_9", ["Radiolarian 9", "Radio Crystal"], [1, 1/3])
def_ft_icosahedron("radio_10", ["Radiolarian 10", "Radio Nova"], [1, 1/3 - 0.05])
def_ft_icosahedron("radio_11", ["Radiolarian 11", "Radio Star"], [1, RADIO_11])
def_ft_icosahedron("radio_12", ["Radiolarian 12", "Radio Nebula"], [1, RADIO_12])
def_ft_icosahedron("radio_13", ["Radiolarian 13", "Radio Gem"], [1, RADIO_13])
def_ft_icosahedron("radio_14", ["Radiolarian 14", "Radio Fathom"], [1, 0.05])
def_ft_icosahedron("radio_15", ["Radiolarian 15", "Radio Chop"], [1, 0, -1], add_opposite = false)

