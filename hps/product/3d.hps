// ------------------- //
// Tetrahedron puzzles //
//-------------------- //

fn n_layer_prefix(n, *, default=3) { if n == default { "" } else { "${n}-Layer " } }

add_puzzle_list_entry("tetrahedron_a(1)")
add_puzzle(id = "tetrahedron_a", name = "N-Layer Tetrahedron A",
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 3,
    colors = "tetrahedron",
    twists = "tetrahedron_ft",
    params = [cuts_param],
    gen = fn(cuts) {
        return #{
            name = n_layer_prefix(cuts + 1, default = 2) ++ "Tetrahedron A",
            build = fn() {
                @util.build_symmetric_shape(@shapes/3d/tetrahedron.new())
                #puz.layers.R = [∞] ++ @util.layers.exclusive(-1/3, -1, cuts, padding=1/2) ++ [-∞]
            },
        }
    }
)

add_puzzle(id = "tetrahedron_b", name = "Tetrahedron B",
    aliases = ["Tetraminx"],
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 3,
    colors = "tetrahedron",
    twists = "tetrahedron_ft",
    build = fn() {
        @util.build_symmetric_shape(@shapes/3d/tetrahedron.new())
        #puz.layers.R = [∞, -1/3, -∞]
    },
)

add_puzzle_list_entry("tetrahedron_c(1)")
add_puzzle_list_entry("tetrahedron_c(4)")
add_puzzle(id = "tetrahedron_c", name = "N-Layer Tetrahedron C",
    aliases = ["N-Layer FT Tetrahedron"],
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 3,
    colors = "tetrahedron",
    twists = "tetrahedron_ft",
    params = [cuts_param],
    gen = fn(cuts) {
        return #{
            name = n_layer_prefix(cuts + 1, default = 2) ++ "Tetrahedron C",
            aliases = if cuts == 1 {
                ["Jing's Pyraminx", "Halpern-Meier Tetrahedron", "Obieemnaia Logicheskaia Igra"]
            } else if cuts == 4 {
                ["Royal Tetrahedron"]
            },
            build = fn() {
                @util.build_symmetric_shape(@shapes/3d/tetrahedron.new())
                #puz.layers.R = @util.ft_tetrahedron_shallow_cut_depths(3, cuts)
            },
        }
    }
)

