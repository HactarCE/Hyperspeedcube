        #twists.stabilizer_twists = [
            [["R", "U"], 1],
            [["R", "U", "F"], lerp(√2, 1/√2, GIZMO_EDGE_FACTOR)],
        ]
        #twists.stabilizer_sets = [
            [["R", "U"], shape.edge.mag * lerp(1, 1/2, GIZMO_EDGE_FACTOR)],
            [["R", "U", "F"], shape.vertex.mag * lerp(1, 1/3, GIZMO_EDGE_FACTOR)],
        ]
    },
)

