// cube_points =
layers_param = #{ name = "Layers", type = Int, default = 3, min = 1, max = 50 }

add_twist_system(id = "cube_ft", name = "FT Cube",
    engine = "symmetric",
    ndim = 3,
    build = fn() {
        shape = @shapes/3d/cube.new()
        #twists.sym = shape.sym
        #twists.points = shape.points
        #twists.axes = [shape.facet]
        // #twists.stabilizer_twists = []
        #twists.stabilizer_sets = [[["R", "U"], shape.edge.mag * 2/3]]
        #twists.stabilizer_sets = [[["R", "U", "F"], shape.vertex.mag * 2/3]]
    },
)

add_puzzle(id = "cube_ft", name = "FT Cube",
    aliases = ["FT Hexahedron", "n^3", "N-Layer Rubik's Cube"],
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 3,
    colors = "cube",
    twists = "cube_ft",
    params = [layers_param],
    gen = fn(layers) {
        return #{
            name = "${layers}^3",
            build = fn() {
                @util.build_symmetric_shape(@shapes/3d/cube.new())
                // TODO: realistic proportions
                #puz.layers.R = @util/layers.inclusive(1, -1, layers)
            },
        }
    }
)

