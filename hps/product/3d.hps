add_puzzle_list_entry("megaminx(1)")
add_puzzle_list_entry("megaminx(2)")
add_puzzle_list_entry("megaminx(3)")
add_puzzle_list_entry("megaminx(4)")
add_puzzle_list_entry("megaminx(5)")
add_puzzle_list_entry("megaminx(6)")
add_puzzle_list_entry("megaminx(7)")
add_puzzle_list_entry("megaminx(8)")
add_puzzle_list_entry("megaminx(9)")
add_puzzle_list_entry("megaminx(10)")
add_puzzle(id = "megaminx", name = ["N-Layer Megaminx", "N-Layer FT Dodecahedron (Shallow)"],
    tags = #{ author = ["Andrew Farkas", "Milo Jacquet"] },
    engine = "symmetric",
    ndim = 3,
    colors = "dodecahedron",
    twists = "dodecahedron_ft",
    params = [cuts_param],
    gen = fn(cuts) {
        names = [n_cut_prefix(cuts) ++ "Megaminx"]
        metric_names = [null, "Megaminx", "Gigaminx", "Teraminx", "Petaminx", "Examinx", "Zettaminx", "Yottaminx", "Ronnaminx", "Atlasminx", "Minx of Madness"]
        metric_name = metric_names[cuts]
        if metric_name != null {
            names = [metric_name] ++ names
        }
        if cuts == 1 {
            names ++= ["Canon-Cut Dodecahedron", "Hungarian Supernova"]
        }
        if cuts == 9 {
            names ++= ["Quettaminx"]
        }
        return #{
            name = names,
            build = fn() {
                @util.build_symmetric_shape(@shapes/3d/dodecahedron.new())
                #puz.layers.F = @util/layers/ft.dodecahedron_shallow(cuts)
            },
        }
    }
)

add_puzzle(id = "megaminx_crystal", name = "Megaminx Crystal",
    tags = #{ author = ["Andrew Farkas", "Milo Jacquet"] },
    engine = "symmetric",
    ndim = 3,
    colors = "dodecahedron",
    twists = "dodecahedron_ft",
    build = fn() {
        t = cos(π/10) * tan(π/5) / (2 - sin(π/10))
        depth = lerp(@util/layers/ft.MEGAMINX_DEPTH, @util/layers/ft.PYRAMINX_CRYSTAL_DEPTH, t)
        @util.build_symmetric_shape(@shapes/3d/dodecahedron.new())
        #puz.layers.F = [1, depth, -depth, -1]
    },
)

add_puzzle(id = "pyraminx_crystal", name = "Pyraminx Crystal",
