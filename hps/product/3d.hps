        #twists.stabilizer_twists = [
            [["R", "F"], √2],
        ] // TODO
        #twists.stabilizer_sets = [] // TODO
    },
)

add_twist_system(id = "cube_ft", name = "FT Cube",
    engine = "symmetric",
    ndim = 3,
    build = fn() {
        shape = @shapes/3d/cube.new()
        #twists.sym = shape.sym
