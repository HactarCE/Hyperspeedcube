add_puzzle_list_entry("octahedron_ft_adj(2)")
add_puzzle_list_entry("octahedron_ft_adj(3)")
add_puzzle(id = "octahedron_ft_adj", name = "N-Layer FT Octahedron",
    tags = #{ author = ["Andrew Farkas", "Milo Jacquet"] },
    engine = "symmetric",
    ndim = 3,
    colors = "octahedron",
    twists = "octahedron_ft",
    params = [layers_param],
    gen = fn(layers) {
        names = ["Adjacent-Cut " ++ n_layer_prefix(layers) ++ "FT Octahedron"]
        if layers == 2 { names ++= ["Skewb Diamond"] }
        if layers == 3 { names ++= ["Face-Turning Octahedron"] }
        if layers == 4 { names ++= ["Master Face-Turning Octahedron"] }
        return #{
            name = names,
            build = fn() {
                @util.build_symmetric_shape(@shapes/3d/octahedron.new())
                #puz.layers.F = @util/layers.inclusive(1, -1, layers)
            },
        }
    }
)

add_puzzle_list_entry("octahedron_ft_shallow(1)")
add_puzzle(id = "octahedron_ft_shallow", name = "N-Layer FT Octahedron (Shallow)",
    tags = #{ author = ["Andrew Farkas", "Milo Jacquet", "Luna Harran"] },
    engine = "symmetric",
    ndim = 3,
    colors = "octahedron",
    twists = "octahedron_ft",
    params = [cuts_param],
    gen = fn(cuts) {
        names = [n_cut_prefix(cuts) ++ "Shallow-Cut FT Octahedron"]
        if cuts == 1 { names ++= ["Canon-Cut Octahedron"] }
        return #{
            name = names,
            build = fn() {
                @util.build_symmetric_shape(@shapes/3d/octahedron.new())
                l = @util/layers.inclusive_exclusive(1, 1/3, cuts + 1)
                #puz.layers.F = @util/layers/ft.octahedron_shallow(cuts)
            },
        }
    }
)

