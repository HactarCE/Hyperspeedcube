layers_param = #{ name = "Layers", type = Int, default = 3, min = 1, max = 50 }

add_menu_entry(path = "Solid|1D",      next_column = "Shape")
add_menu_entry(path = "Solid|1D|Line", id = "line", default = true)

add_twist_system(id = "line@1", name = "Line",
    engine = "symmetric",
    ndim = 1,
    build = fn() {
        #twists.shape = @shapes/1d/line.new()
        #twists.sym = #twists.shape.sym
        #twists.points = #twists.shape.points
        #twists.axes ++= [#twists.sym.x]
    },
)

add_puzzle(id = "line@1", name = "Line",
    tags = #{ author = "Andrew Farkas" },
    engine = "symmetric",
    ndim = 1,
    colors = "line",
    twists = "line",
    params = [layers_param],
    gen = fn(layers) {
        return #{
            name = "{}" ++ if layers == 3 { "" } else { " ${layers}" },
            build = fn() {
                @util.build_symmetric_shape(@shapes/1d/line.new())
                #puz.layers.A = @util/layers.inclusive(layers)
            },
        }
    },
)
