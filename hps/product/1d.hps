layers_param = #{ name = "Layers", type = Int, default = 3, min = 1, max = 49 }

add_menu_entry(path = "Solid|1D|Line", id = "line", default = true)

line_tags = #{
    ndim = 1,
    author = "Andrew Farkas",
}

add_twist_system( // Line
    id = "line",
    engine = "symmetric",
    ndim = 1,
    build = fn() {
        #twists.shape = @shapes/1d/line.new()
        #twists.sym = #twists.shape.sym
        #twists.points = #twists.shape.named_points
        #twists.axes ++= [#twists.sym.x]
    },
)

add_puzzle( // Line
    id = "line",
    name = "Line",
    engine = "symmetric",
    tags = line_tags,
    params = [layers_param],
    gen = fn(layers) {
        return #{
            name = "{}" ++ if layers == 3 { "" } else { " ${layers}" },
            colors = "line",
            twists = "line",
            tags = line_tags,
            build = fn() {
                @util.build_symmetric_shape(@shapes/1d/line.new())
                #puz.layers.A = @util/layers.inclusive(layers)
            },
        }
    },
)
