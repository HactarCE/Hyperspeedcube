add_twist_system(
    id = "hypercube_ft",
    name = "FT Hypercube",
    engine = "symmetric",
    ndim = 4,
    build = fn() {
        shape = @shapes/4d/hypercube.new()
        @util.build_symmetric_ft_twists(shape)
        // #twists.stabilizer_twists ++= [[["A", "B"], shape.edge_length/2]]
        // #twists.stabilizer_sets ++= [[["A", "B"], lerp(shape.circumradius, @shapes/2d/polygon.new(n).inradius, GIZMO_VERTEX_FACTOR)]]
    }
)

add_puzzle_generator(
    id = "hypercube_ft",
    name = "FT Hypercube",
    version = "0.1.0",
    params = [#{ name = "Layers", type = Int, default = 3, min = 1, max = 50 }],
    engine = "symmetric",
    ndim = 4,
    gen = fn(layers) {
        export name = "${layers}^4"
        export colors = "hypercube"
        export twists = "hypercube_ft"
        export fn build() {
            @util.build_symmetric_shape(@shapes/4d/hypercube.new())
            #puz.layers.R = @util.layers.inclusive(layers)
        }
    },
)
