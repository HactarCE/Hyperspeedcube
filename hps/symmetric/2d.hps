add_menu_entry(
    path = "2D|Polygon",
    priority = -5,
    default = true,
    next_inline = "Depth"
)

add_menu_entry(
    path = "2D|Polygon|Shallow",
    priority = 3,
    default = true,
    id = "ngon_shallow",
)

add_menu_entry(
    path = "2D|Polygon|Deep",
    priority = 2,
    id = "ngon_deep",
)

add_menu_entry(
    path = "2D|Polygon|Layered",
    priority = 1,
    id = "ngon_layered",
)

export fn ngon_colors(n, *, prefix = "", seq = "Rainbow") -> List[Map] {
    (0..n).map(fn(i) {
        #{
            name = "${prefix}${nth_uppercase(i)}",
            default = "${seq} [${i}/${n}]",
        }
    })
}
