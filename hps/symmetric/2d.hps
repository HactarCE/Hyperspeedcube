add_menu_entry(path = "2D|Triangle",            next_inline = "Depth",    priority = -3)
add_menu_entry(path = "2D|Triangle|Shallow",    id = "triangle_ft_shallow")
add_menu_entry(path = "2D|Triangle|Triminx",    id = "triangle_layered")
add_menu_entry(path = "2D|Square",              id = "square_ft_layered", priority = -4)
add_menu_entry(path = "2D|Polygon",             next_inline = "Axes",     priority = -5,  default = true)
add_menu_entry(path = "2D|Polygon|FT",          next_inline = "Depth",    priority = 1,   default = true)
add_menu_entry(path = "2D|Polygon|FT|Shallow",  id = "ngon_ft_shallow",   priority = 100, default = true)
add_menu_entry(path = "2D|Polygon|FT|Deep",     id = "ngon_ft_deep",      priority = 3)
add_menu_entry(path = "2D|Polygon|FT|Half",     id = "ngon_ft_half",      priority = 2)
add_menu_entry(path = "2D|Polygon|FT|Layered",  id = "ngon_ft_layered",   priority = 1)
