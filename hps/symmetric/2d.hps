add_puzzle_generator(
    id = "triangle_ft_shallow",
    name = "FT Triangle (Shallow)",
    version = "0.1.0",
    params = [edge_divisions_param],
    engine = "symmetric",
    ndim = 2,
    gen = fn(divisions) { "ngon_ft_shallow(3,${divisions})" },
)

add_puzzle_generator(
    id = "square_ft_layered",
    name = "FT Square",
    version = "0.1.0",
    params = [layers_param],
    engine = "symmetric",
    ndim = 2,
    gen = fn(layers) { "ngon_ft_layered(4,${layers})" }
)

add_puzzle_generator(
    id = "triangle_layered",
    name = "FT Triangle (Layered)",
    version = "0.1.0",
    params = [layers_param],
    engine = "symmetric",
    ndim = 2,
    gen = fn(layers) { "ngon_ft_layered(3, ${layers})" },
)

add_puzzle_generator(
    id = "ngon",
    name = "Polygon",
    version = "0.1.0",
    params = [#{ name = "Edges", type = Int, default = 5, min = 3, max = 100 }],
    engine = "symmetric",
    ndim = 2,
    gen = fn(n) {
        export name = "${@shapes/2d/polygon.name(n)}"
        export colors = "ngon(${n})"
        export fn build() {
            @util.build_symmetric_shape(@shapes/2d/polygon.new(n))
            #twists.sym = #shape.sym
        }
    },
)

add_puzzle_generator(
    id = "ngon_ft_shallow",
    name = "FT Polygon (Shallow-Cut)",
    version = "0.1.0",
    params = [
        #{ name = "Edges", type = Int, default = 5, min = 3, max = 100 },
        edge_divisions_param,
    ],
    engine = "symmetric",
    ndim = 2,
    gen = fn(n, divisions) {
        export name = "{${n}}" ++ if divisions == 3 { "" } else { " ${divisions}" }
        export colors = "ngon(${n})"
        export twists = "ngon_ft(${n})"
        export fn build() {
            @util.build_symmetric_shape(@shapes/2d/polygon.new(n))
            #puz.layers.A = @shapes/2d/polygon.new(n).shallow_cut_depths(divisions)
        }
    },
)

add_puzzle_generator(
    id = "ngon_ft_deep",
    name = "FT Polygon (Deep-Cut)",
    version = "0.1.0",
    params = [
        #{ name = "Edges", type = Int, default = 5, min = 3, max = 100 },
        edge_divisions_param,
    ],
    engine = "symmetric",
    ndim = 2,
    gen = fn(n, divisions) {
        export name = "Deep {${n}}" ++ if divisions == 3 { "" } else { " ${divisions}" }
        export colors = "ngon(${n})"
        export twists = "ngon_ft(${n})"
        export fn build() {
            @util.build_symmetric_shape(@shapes/2d/polygon.new(n))
            #puz.layers.A = @shapes/2d/polygon.new(n).deep_cut_depths(divisions)
        }
    },
)

add_puzzle_generator(
    id = "ngon_ft_half",
    name = "FT Polygon (Half-Cut)",
    version = "0.1.0",
    params = [
        #{ name = "Edges", type = Int, default = 5, min = 3, max = 100 },
    ],
    engine = "symmetric",
    ndim = 2,
    gen = fn(n) {
        export name = "Half-Cut {${n}}"
        export colors = "ngon(${n})"
        export twists = "ngon_ft(${n})"
        export fn build() {
            @util.build_symmetric_shape(@shapes/2d/polygon.new(n))
            #puz.layers.A = [∞, 0, -∞]
        }
    },
)

add_puzzle_generator(
    id = "ngon_ft_layered",
    name = "FT Polygon (Layered)",
    version = "0.1.0",
    params = [
        #{ name = "Edges", type = Int, default = 5, min = 3, max = 100 },
        layers_param,
    ],
    engine = "symmetric",
    ndim = 2,
    gen = fn(n, layers) {
        export name = "Layered {${n}}" ++ if layers == 3 { "" } else { " ${layers}" }
        export colors = "ngon(${n})"
        export twists = "ngon_ft(${n})"
        export fn build() {
            @util.build_symmetric_shape(@shapes/2d/polygon.new(n))
            #puz.layers.A = @shapes/2d/polygon.new(n).layered_cut_depths(layers)
        }
    },
)

