layers_param = #{ name = "Layers", type = Int, default = 3, min = 1, max = 49 }

add_menu_entry(
    path = "1D|Line",
    default = true,
    id = "line",
    params = [layers_param],
    build = fn(layers) {
        export shape = @shapes/1d/line.new()
        export colors = "line"
        carve(shape.vertex_pole, shape.vertex_names)
        add_axis(shape.vertex_pole, shape.vertex_names, @util/layers.inclusive(layers))
    },
)

add_colors_override("line", fn() {
    [
        #{ name = "A", default = "Red" },
        #{ name = "B", default = "Blue" },
    ]
})

add_puzzle(
    id = "line",
    version = "1.0.0",
    engine = "symmetric",
    ndim = 1,
    twists = "line",
    colors = "line",
    build = fn() {

    },
)

add_twist_system(
    id = "line",
    name = "Line",
    engine = "line",
    ndim = 1,
    build = fn() {
        #twists.shape = @shapes/1d/line.new()
        #axes.vertex = add_axis(#twists.shape.vertex_pole, #twists.shape.vertex_names)
    },
)
