layers_param = #{ name = "Layers", type = Int, default = 3, min = 1, max = 49 }

add_menu_entry(
    path = "1D|Line",
    default = true,
    id = "line",
)

@util.add_symmetric_ft_twist_system(@shapes/1d/line)

add_puzzle_generator(
    id = "line",
    name = "Line",
    version = "0.1.0",
    params = [layers_param],
    engine = "symmetric",
    ndim = 1,
    colors = "line",
    twists = "line",
    gen = fn(layers) {
        export name = "{}" ++ if layers == 3 { "" } else { " ${layers}" }
        export fn build() {
            @util.build_symmetric_shape(@shapes/1d/line.new())
            #puz.layers.A = @util/layers.inclusive(layers)
        }
    }
)
