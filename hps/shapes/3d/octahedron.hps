use * from euclid

export fn new() -> Map { new(ident()) }
export fn new(t: Transform) -> Map {
    export fn transform_by(t2: Transform) -> Map { new(t2 * t) }

    export sym = t.transform(cd("bc3"))

    export face = sym.xoo.unit
    export edge = sym.oxo.unit * √6/2
    export vertex = sym.oox.unit * √3

    export facet = face
    export ridge = edge
    export peak = vertex

    export points = [#{
        vector = facet,
        names = sym.names(point(facet), #{
            U = [],
            L = [0, "U"],
            R = [1, "L"],
            F = [0, "R"],
            BD = [2, "R"], // B in standard notation
            BL = [0, "BD"],
            BR = [1, "BL"],
            D = [0, "BR"],
        }),
    }]
}

add_color_system(
    id = "octahedron@1",
    name = "Octahedron",
    default_scheme = "Diansheng",
    schemes = #{
        "Lanlan" = #{
