use * from euclid

export aliases = ["3-Cube", "Hexahedron", "1x1x1", "1^3"]
export ndim = 3

export fn new() -> Map { new(ident()) }
export fn new(t: Transform) -> Map {
    export fn transform_by(t2: Transform) -> Map { new(t2 * t) }

    export ndim
    export sym = t.transform(cd("bc3"))

    export face = sym.oox.unit
    export edge = sym.oxo.unit * √2
    export vertex = sym.xoo.unit * √3

    export facet = face
    export ridge = edge
    export peak = vertex

    export points = [#{
        vector = facet,
        names = sym.names(point(facet), #{
            F = [],
            U = [2, "F"],
            R = [1, "U"],
            L = [0, "R"],
            D = [1, "L"],
            B = [2, "D"],
        }),
    }]
}

export facet_colors_list = [
    #{name = "R", display = "Right"},
    #{name = "L", display = "Left"},
    #{name = "U", display = "Up"},
    #{name = "D", display = "Down"},
    #{name = "F", display = "Front"},
    #{name = "B", display = "Back"},
]

western_color_scheme = #{
    R = "Red",
    L = "Orange",
    U = "White",
    D = "Yellow",
    F = "Green",
    B = "Blue",
}

add_color_system(id = "cube", name = "Cube",
    schemes = #{
        Western = western_color_scheme,
        Japanese = #{
            D = "Blue",
            B = "Yellow",
            **western_color_scheme,
        },
        // Japanese = #{
        //     R = "Red",
        //     L = "Orange",
        //     U = "White",
        //     D = "Blue",
        //     F = "Green",
        //     B = "Yellow",
        // },
        OP = #{
            D = "Black",
            L = "Green",
            F = "Yellow",
            **western_color_scheme
        },
    },
)

