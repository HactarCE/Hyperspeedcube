use * from euclid

export fn new() -> Map { new(ident()) }
export fn new(t: Transform) -> Map {
    export fn transform_by(t2: Transform) -> Map { new(t2 * t) }

    export sym = t.transform(cd([5, 3]))

    // source: https://polytope.miraheze.org/wiki/Dodecahedron
    circumradius = (√3 + √15) / 4
    edge_radius = (3 + √5) / 4
    inradius = √((25 + 11*√5) / 40)

    export face = sym.oox.unit
    export edge = sym.oxo.unit * edge_radius/inradius
    export vertex = sym.xoo.unit * circumradius/inradius

    export facet = face
    export ridge = edge
    export peak = vertex

    export points = [#{
        vector = facet,
        names = sym.names(point(facet), #{
            F = [],
            U = [2, "F"],
            R = [1, "U"],
            L = [0, "R"],
            DR = [1, "L"],
            DL = [0, "DR"],
            BR = [2, "DR"],
            BL = [2, "DL"],
            PR = [1, "BL"],
            PL = [0, "PR"],
            PD = [1, "PL"],
            PB = [2, "PD"],
        }),
    }]
}

add_color_system(
    id = "dodecahedron@1",
    name = "Dodecahedron",
    colors = #{
        U = "White",
        F = "Green Dyad [1]",
        R = "Red",
        L = "Purple",
        BR = "Blue Dyad [1]",
        BL = "Yellow Dyad [1]",
        DR = "Yellow Dyad [0]",
        DL = "Blue Dyad [0]",
        PR = "Pink",
        PL = "Orange",
        PB = "Green Dyad [0]",
        PD = "Gray",
    },
)
