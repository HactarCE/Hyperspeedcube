            L = "Magenta Triad [1]",
            S = "Blue Dyad [0]",
            N = "Teal",
            G = "Red Triad [1]",
            Q = "Blue Dyad [1]",
            H = "Green Triad [1]",
            P = "Orange",
            I = "Mono Tetrad [3]",
            A = "Mono Tetrad [0]",
            J = "Yellow",
            C = "Brown",
            M = "Magenta Dyad [0]",
        },
        Twizzle = #{
            U = "Mono Tetrad [1]",
            D = "Mono Tetrad [0]",
            E = "Mono Tetrad [2]",
            O = "Mono Tetrad [3]",
            F = "Green Triad [1]",
            B = "Green Triad [0]",
            R = "Yellow Dyad [1]",
