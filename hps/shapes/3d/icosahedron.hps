use * from euclid

export fn new() -> Map { new(ident()) }
export fn new(t: Transform) -> Map {
    export fn transform_by(t2: Transform) -> Map { new(t2 * t) }

    dodecahedron = @shapes/3d/dodecahedron.new(t)

    export sym = dodecahedron.sym

    // source: https://polytope.miraheze.org/wiki/Icosahedron
    circumradius = √((5 + √5) / 8)
    edge_radius = (1 + √5) / 4
    inradius = (3*√3 + √15) / 12

    export face = sym.xoo.unit
    export edge = sym.oxo.unit * edge_radius/inradius
    export vertex = sym.oox.unit * circumradius/inradius

    export facet = face
    export ridge = edge
    export peak = vertex

    export points = [#{
        vector = facet,
        names = sym.names(point(facet), #{
            J = [],
            M = [0, "J"],
            G = [1, "M"],
            Q = [0, "G"],
            S = [2, "G"],
            U = [1, "Q"],
            K = [0, "S"],
            B = [2, "U"],
            E = [1, "K"],
            I = [1, "B"],
            P = [0, "E"],
            O = [0, "I"],
            F = [1, "P"],
            R = [1, "O"],
            D = [2, "F"],
            L = [0, "R"],
            H = [1, "D"],
            N = [0, "H"],
            C = [1, "N"],
            A = [0, "C"],
        }),
    }]
}

add_color_system(
    id = "icosahedron",
    name = "Icosahedron",
    default_scheme = "FTI Standard",
    schemes = #{
        "FTI Standard" = #{
            U = "Mono Tetrad [1]",
            D = "Purple Dyad [0]",
            E = "Purple",
