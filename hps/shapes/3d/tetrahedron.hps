use * from euclid

export fn new() -> Map { new(ident()) }
export fn new(t: Transform) -> Map {
    export fn transform_by(t2: Transform) -> Map { new(t2 * t) }

    export sym = t.transform(cd("a3"))

    export face = sym.oox.unit
    export edge = sym.oxo.unit * √3
    export vertex = sym.xoo.unit * 3

    export facet = face
    export ridge = edge
    export peak = vertex

    // Tetrahedron standards are inconsistent. In Twizzle Explorer Alpha:
    //
    // - FT/VT tetrahedron uses `F D BR BL` for faces and `R L U B` for vertices
    // - ET tetrahedron uses `FR LF DF RL` for edges in a way that implies `F D
    //   R L` for faces
    //
    // Since named points must be prefix-free, `BL BR` are not allowed. So we
    // use the ET naming scheme for faces.
    //
    // We could introduce more concise vertex names `U B PR PL`, but this would
    // make the edge names unreasonable long since each edge is equidistant to
    // two faces and two vertices.
    export points = [#{
        vector = facet,
        names = sym.names(point(facet), #{
            D = [],
            F = [2, "D"],
            R = [1, "F"],
            L = [0, "R"],
        }),
    }]
}

add_color_system(
    id = "tetrahedron@1",
    name = "Tetrahedron",
    colors = #{
        L = "Red",
        R = "Blue",
        F  = "Green",
        D  = "Yellow",
    },
)
