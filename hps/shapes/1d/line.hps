use * from euclid

export fn new() -> Map { new(ident()) }
export fn new(t: Transform) -> Map {
    export fn transform_by(t2: Transform) -> Map { new(t2 * t) }

    export sym = t.transform(cd([]))

    export vertex = sym.x.unit
    export facet = vertex

    export points = [#{
        vector = vertex,
        names = sym.names(point(vertex), #{
            A = [],
            B = [0, "A"]
        }),
    }]
}

add_color_system(
    id = "line@1",
    name = "Line",
    colors = #{
        A = "Red",
        B = "Blue",
    },
)
