use * from euclid

export fn new() -> Map { new(ident()) }
export fn new(t: Transform) -> Map {
    export fn transform_by(t2: Transform) -> Map { new(t2 * t) }

    export ndim = 1
    export sym = t.transform(cd("a1"))

    export vertex = sym.x.unit
    export facet = vertex

    export named_points = [#{
        vector = vertex,
        names = sym.names(point(vertex), #{
            A = [],
            B = [0, "A"]
        }),
    }]

}

add_color_system(
    id = "line",
    name = "Line",
    colors = #{
        A = "Red",
        B = "Blue",
    },
)
