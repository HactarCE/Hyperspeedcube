use * from euclid

export fn new() -> Map { new(ident()) }
export fn new(t: Transform) -> Map {
    export fn transform_by(t2: Transform) -> Map { new(t2 * t) }

    export sym = t.transform(cd("f4"))

    export cell = sym.ooox.unit
    export face = sym.ooxo.unit * 2*√6
    export edge = sym.oxoo.unit * √3/√2
    export vertex = sym.xooo.unit * √2

    export facet = cell
    export ridge = face
    export peak = edge

    export points = [#{
        vector = facet,
        names = sym.names(point(facet), #{
            // swirl 1
            A = [3, "B"],
            B = [2, "N"],
            C = [2, "V"],
            D = [],
            E = [3, "D"],
            F = [3, "C"],
            // swirl 2
            G = [1, "S"],
            H = [2, "G"],
            I = [2, "L"],
            J = [0, "P"],
            K = [0, "W"],
            L = [1, "R"],
            // swirl 3
            M = [0, "G"],
            N = [1, "T"],
            O = [1, "I"],
            P = [2, "W"],
            Q = [2, "E"],
            R = [0, "X"],
            // swirl 4
            S = [2, "F"],
            T = [0, "H"],
            U = [0, "O"],
            V = [1, "J"],
            W = [1, "Q"],
            X = [3, "P"],
        }),
    }]
}

