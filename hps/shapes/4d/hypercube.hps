use * from euclid

export fn new() -> Map { new(ident()) }
export fn new(t: Transform) -> Map {
    export fn transform_by(t2: Transform) -> Map { new(t2 * t) }

    export sym = t.transform(cd("bc4"))

    export cell = sym.ooox.unit
    export face = sym.ooxo.unit * √2
    export edge = sym.oxoo.unit * √3
    export vertex = sym.xooo.unit * 2

    export facet = cell
    export ridge = face
    export peak = edge

    export points = [#{
        vector = facet,
        names = sym.names(point(facet), #{
            O = [],
            F = [3, "O"],
            U = [2, "F"],
            R = [1, "U"],
            L = [0, "R"],
            D = [1, "L"],
            B = [2, "D"],
            I = [3, "B"],
        }),
    }]
}

add_color_system(
    id = "hypercube@1",
    name = "Hypercube",
    colors = #{
        R = "Red",
        L = "Orange",
        U = "White",
        D = "Yellow",
        F = "Green",
        B = "Blue",
        O = "Pink",
        I = "Purple",
    },
)
