use * from euclid

export fn new() -> Map { new(ident()) }
export fn new(t: Transform) -> Map {
    export fn transform_by(t2: Transform) -> Map { new(t2 * t) }

    export sym = t.transform(cd("h4"))

    export cell = sym.xooo.unit
    export face = sym.oxoo.unit * (√30-√6)/3
    export edge = sym.ooxo.unit * (2*φ-3) * √(8*φ+6)
    export vertex = sym.ooox.unit * √2 * (3-√5)

    export facet = cell
    export ridge = face
    export peak = edge

    export points = @shapes/4d/120cell.new().points
}

