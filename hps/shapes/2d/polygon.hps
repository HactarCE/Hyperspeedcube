use * from euclid

export edges_param = #{ name = "Edges", type = Int, default = 5, min = 3, max = 100 }

export fn new(n: Nat) -> Map { new(n, ident()) }
export fn new(n: Nat, t: Transform) -> Map {
    export fn transform_by(t2: Transform) -> Map { new(n, t2 * t) }

    export ndim = 2
    export sym = t.transform(cd([n]))

    export edge_length = 2

    export inradius = edge_length / (2 * tan(π/n))
    export circumradius = edge_length / (2 * sin(π/n))
    export vertex_height = inradius + if n.is_even() { inradius } else { circumradius }
    export ft_edge_depth = edge_length * sin(2*π/n)
    export vt_edge_depth = edge_length * sin(π/n)

    export edge = sym.ox.unit * inradius
    export vertex = sym.xo.unit * circumradius

    export facet = edge
    export ridge = vertex

    point_names = #{}
    point_names[nth_uppercase(0)] = []
    for i in 1..n {
        point_names[nth_uppercase(i)] = [1, 0, nth_uppercase(i-1)]
    }
    export points = [#{
        vector = sym.ox.unit * inradius,
        names = sym.names(point(facet), point_names),
    }]

    export fn shallow_ft_cuts(cut_count: Nat) -> List[Num] {
        if n == 3 {
            return @util/cuts.even_odd(cut_count, [inradius, 0])
        } else {
            max_cut_depth = inradius - ft_edge_depth/2
            return @util/cuts.even_odd(cut_count, [inradius, max_cut_depth])
        }
    }

    export fn deep_ft_cuts(cut_count: Nat) -> List[Num] {
        @util/cuts.spaced(cut_count, [inradius, inradius - ft_edge_depth], 0)
    }

    export fn layered_ft_cuts(cut_count: Nat) -> List[Num] {
        @util/cuts.spaced(cut_count, [inradius, -if n.is_even() { inradius } else { circumradius }])
    }

    export fn layered_vt_cuts(cut_count: Nat) -> List[Num] {
        @util/cuts.spaced(cut_count, [circumradius, -if n.is_even() { circumradius } else { inradius }])
    }

    max_adjacent_vt_cut_depth = ft_edge_depth - inradius
    export fn adjacent_vt_cuts(cut_count: Nat) -> List[Num] {
        @util/cuts.spaced(cut_count, [circumradius, circumradius - vt_edge_depth], [1, 0])
    }
}

add_color_system(
    id = "ngon@1",
    name = "Polygon",
    params = [edges_param],
    gen = fn(n) {
        colors = #{}
        for i in 0..n {
            colors[nth_uppercase(i)] = "Rainbow [${i}/${n}]"
        }
        return #{ name = "${n}", colors = colors }
    },
)
