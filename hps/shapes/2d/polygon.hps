use * from euclid

export edges_param = #{ name = "Edges", type = Int, default = 5, min = 3, max = 100 }

export fn new(n: Nat) -> Map { new(n, ident()) }
export fn new(n: Nat, t: Transform) -> Map {
    export fn transform_by(t2: Transform) -> Map { new(n, t2 * t) }

    export ndim = 2
    export sym = t.transform(cd([n]))

    export edge_length = 2

    export inradius = edge_length / (2 * tan(π/n))
    export circumradius = edge_length / (2 * sin(π/n))
    export vertex_height = inradius + if n.is_even() { inradius } else { circumradius }
    export ft_edge_depth = edge_length * sin(2*π/n)
    export vt_edge_depth = edge_length * sin(π/n)

    export edge = sym.ox.unit * inradius
    export vertex = sym.xo.unit * circumradius

    export facet = edge
    export ridge = vertex

    point_names = #{}
    point_names[nth_uppercase(0)] = []
    for i in 1..n {
        point_names[nth_uppercase(i)] = [1, 0, nth_uppercase(i-1)]
    }
    export points = [#{
        vector = sym.ox.unit * inradius,
        names = sym.names(point(facet), point_names),
    }]

    export fn shallow_cut_depths(layer_count: Nat) -> List[Num] {
        if n == 3 {
            return @util/layers.even_odd(inradius, 0, layer_count) ++ [-∞]
        } else {
            max_cut_depth = inradius - ft_edge_depth/2
            return @util/layers.even_odd(inradius, max_cut_depth, layer_count)
        }
    }

    max_deep_cut_depth = inradius - ft_edge_depth
    export fn deep_cut_depths(layer_count: Nat) -> List[Num] {
        @util/layers.inclusive(inradius, max_deep_cut_depth, layer_count)
    }

    export fn layered_cut_depths(layer_count: Nat) -> List[Num] {
        @util/layers.inclusive(inradius, inradius - vertex_height, layer_count)
    }

    if n == 3 {
        export fn opposite_full_cut_depths(layer_count: Nat) -> List[Num] {
            @util/layers.inclusive(-max_cut_depth, -inradius, layer_count)
        }
    }

    max_adjacent_vt_cut_depth = ft_edge_depth - inradius
    export fn adjacent_vt_cut_depths(layer_count: Nat) -> List[Num] {
        @util/layers.inclusive(circumradius, max_adjacent_vt_cut_depth, layer_count)
    }
}

add_color_system(
    id = "ngon",
    name = "Polygon",
    params = [edges_param],
    gen = fn(n) {
        colors = #{}
        for i in 0..n {
            colors[nth_uppercase(i)] = "Rainbow [${i}/${n}]"
        }
        return #{ name = "${n}", colors = colors }
    },
)
