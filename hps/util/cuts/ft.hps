/// Returns cuts for an N-dimensional FT cube.
export fn cube(ndim: Nat, layers: Nat) -> List[Num] {
    REALISITIC_PROPORTIONS = true
    CORNER_STALK_SIZE = 0.1

    if layers < 2 { return [] }

    aesthetic_limit = 1 - 2/layers
    mechanical_limit = 0
    if REALISITIC_PROPORTIONS {
        mechanical_limit = 1 / √(ndim-1)
    }
    outermost_cut = min(aesthetic_limit, mechanical_limit - CORNER_STALK_SIZE)
    return @util/cuts.spaced(layers-1, outermost_cut, 0)
}

/// Returns cuts for an N-dimensional shallow FT simplex.
export fn simplex_shallow(ndim: Nat, cuts: Nat) -> List[Num] {
    REALISITIC_PROPORTIONS = true
    PADDING = 0.25

    if cuts < 1 { return [] }

    if REALISITIC_PROPORTIONS {
        outer_limit = 1/(ndim - 2/ndim) // f.mag / (((f-v).mag - (f-r).mag) * sin(dihedral_angle) + f.mag)
    } else {
        outer_limit = 1
    }
    // Even though in 3D it is safe to cut all the way to -1/3, canon-cut puzzle
    // products require the presence of the core so we cannot cut below the
    // origin (i.e., 0).
    return @util/cuts.spaced(cuts, [outer_limit, 0], PADDING)
}

/// Returns cuts for a shallow FT octahedron.
///
/// These cuts ensure that all inner layers are isomorphic.
export fn octahedron_shallow(cuts: Nat) -> List[Num] {
    if cuts < 1 { return [] }

    // These are not realistic for large layer counts but it is usable.
    center = 1/2
    half_range = 1/6
    depths = @util/cuts.spaced(cuts, [center + half_range, center - half_range])
    return @util/cuts.with_opposite(depths)
}

//--------------//
// Dodecahedron //
//--------------//

export PYRAMINX_CRYSTAL_DEPTH = 1/√5
export STARMINX_DEPTH = √5 - 2
export MEGAMINX_DEPTH = 1/φ // alternatives: lerp(1/φ, 1, 1/3)
// export MEGAMINX_DEPTH = lerp(1/φ, 1, 1/3)
// export MEGAMINX_DEPTH = lerp(1/φ, 1, 1 / (2 * φ^2 + 1))
// export MEGAMINX_DEPTH = (STARMINX_DEPTH * φ^2 + (1+φ^2)) / (1 + 2*φ^2)

export fn dodecahedron_shallow(cuts: Nat) -> List[Num] {
    // TODO: also add "edge proportioned"
    REALISITIC_PROPORTIONS = true
    AKKEI_PROPORTIONS = false
    CORNER_STALK_SIZE = 0.03

    if cuts == 1 {
        depths = [if AKKEI_PROPORTIONS { lerp(1/φ, 1, 1/(2 * φ^2 + 1)) } else { 1/φ }]
    } else if cuts > 1 {
        aesthetic_limit = 1 - (1 - MEGAMINX_DEPTH)/cuts
        mechanical_limit = 1
        if REALISITIC_PROPORTIONS {
          mechanical_limit = 1/29 * (10 + 7 * √5)
        }
        outermost_cut = min(aesthetic_limit, mechanical_limit - CORNER_STALK_SIZE)
        innermost_cut = if AKKEI_PROPORTIONS {
            // Split the edge into segments of length φ^2, ..., φ^2, 1, φ^2, ..., φ^2
            lerp(1/φ, outermost_cut, 1 / (2 * φ^2 * (cuts-1) + 1))
        } else {
            1/φ
        }
        depths = @util/cuts.spaced(cuts, [outermost_cut, innermost_cut], 0)
    }
    return @util/cuts.with_opposite(depths)
}

export fn curvy_starminx(cuts: Nat) -> List[Num] {
    if cuts < 1 { return [] }

    mid_depth = 1/3
    half_range = √5 - 2 - 1/3 + 0.15
    depths = @util/cuts.spaced(cuts, [mid_depth + half_range, mid_depth - half_range])
    return @util/cuts.with_opposite(depths)
}

export fn pentultimate(layers: Nat) -> List[Num] {
    REALISITIC_PROPORTIONS = true
    CORNER_STALK_SIZE = 0.03

    if layers < 2 { return [] }

    aesthetic_limit = (1 - 2/(layers + 0.6)) * (√5 - 2)
    mechanical_limit = √5 - 2
    if REALISITIC_PROPORTIONS {
        // this is the negative of the galois conjugate of the corresponding value for the megaminx
        mechanical_limit = (-10 + 7 * √5) / 29
    }
    outermost_cut = min(aesthetic_limit, mechanical_limit - CORNER_STALK_SIZE)
    return @util/cuts.spaced(layers-1, outermost_cut)
}

//-------------//
// Icosahedron //
//-------------//

// Sweet spots
export RADIO_4 = 1 / φ
export RADIO_5 = φ^2 / (2 + φ^2)
export RADIO_7 = 5 - 2*√5
export RADIO_8 = 1 / φ^2
export RADIO_11 = 1 / φ^3
export RADIO_12 = 1 / φ^4
export RADIO_13 = 1 / (φ^4 + φ^2)

// Other cut depths (chosen for aesthetics)
export RADIO_2 = 1 - (1-RADIO_4)*2/3
export RADIO_3 = 1 - (1-RADIO_4)*4/5
